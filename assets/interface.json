{
    // 本文件定义了通用 UI（MFAAvalonia / MXU 等）的行为和显示内容
    // 文档：https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    "interface_version": 2,
    "name": "LaserControlAuto",
    "label": "激光控制自动化",
    "description": "在低噪声驱动调试软件里自动设置参数，等待稳定后到测量软件读取数值，逐点记录到 CSV。",
    // 应用图标（Project Interface V2 顶层 icon 字段）。
    // 路径相对 interface.json 所在目录：
    //   开发时 = assets/resource/image/...；打包后 = install/resource/image/...
    // 所以图片必须放在 resource/ 里（docs/ 不会进发布包）。
    // 这张就是 README 顶部用的同一张 maalaser logo（512x512，带透明通道）。
    "icon": "resource/image/maalaser-logo_512.png",
    "license": "MIT",
    // ⚠️ welcome 只能写成「一个字符串」，千万别写成字符串数组 ["...", "..."]。
    //    2026-09-22 踩过的坑：
    //      协议 v2.10.2 起确实允许数组写法，本文件的 schema 校验也放行，
    //      但 MFAAvalonia v2.16.1 的 MaaWelcomeConverter 只认「字符串」和
    //      「对象数组」（元素形如 {"label": "...", "content": "..."}）。
    //      写成字符串数组会抛：
    //          Newtonsoft.Json.JsonSerializationException:
    //          welcome announcement entries must be objects.
    //      后果是整个 interface.json 加载失败 —— 界面上「任务列表」一片空白、
    //      点「+」也没有任务可加、日志区红字「文件 interface.json 加载失败！」。
    //    要写多条公告，就全塞进这一个字符串里，中间用 --- 分隔。
    //    tools/install.py 里已经加了自检：真写成数组会在打包时自动降级并告警。
    "welcome": "## 使用前请先确认\n\n1. **A 软件**（要设置参数的那个）已经打开，并且停在含目标参数的那一页。\n2. **B 软件**（要读数值的那个）也已经打开。\n3. 在下面的「扫描设置」里填好**起始值 / 结束值**，以及**步长**或**扫描点数**（二选一，点数填 0 就走步长），还有**输出文件夹**。\n\n点「开始任务」后程序会自动完成整个扫描，期间请不要用手去动鼠标键盘。\n\n结果会保存成 CSV 文件，路径在运行日志里会打印出来。\n\n---\n\n扫描结束后如果想直接看曲线，执行独立任务「绘制曲线图」：它会自动选最近导出的那份 CSV，以温度为横轴、B 软件读数为纵轴画成 PNG，保存在 CSV 同一目录。",
    "version": "1.0.0",
    "contact": "https://github.com/connorjam/LaserControlAuto",
    "github": "https://github.com/connorjam/LaserControlAuto",

    // ======================================================================
    //  控制器
    //  ⚠️ Win32 控制器一次只能绑定一个窗口，截图和点击都只作用于它。
    //     这里绑定的是「A 软件」；B 软件由 agent 自己另外截图（见 agent/laser_sweep.py）。
    // ======================================================================
    "controller": [
        {
            "name": "桌面端",
            "type": "Win32",
            "win32": {
                "class_regex": ".*",
                // A 软件（Low_Noise_Drive_Debugger_V2.13.exe）的窗口标题，实测为：
                //     Low Noise Driver Debugger V2.13        （class = Qt5QWindowIcon）
                // 用 \s+ 匹配空格，标题里的版本号变了也不影响。
                "window_regex": "Low\\s+Noise\\s+Driver\\s+Debugger",
                // 截图方式。文档: https://maafw.xyz/docs/2.4-ControlMethods
                //
                // ⚠️ 用 FramePool，不要用 PrintWindow / Background：
                //    PrintWindow 遇到「DPI 不感知」的程序（窗口 DPI=96）时，
                //    只会渲染出左上角 1/4 的画面，内容占比 50%，OCR 直接废掉。
                //    Background(=FramePool|PrintWindow) 也不行——框架是「挑最快的」，
                //    实测它会选中 PrintWindow(32ms)，照样坏。
                //
                //    实测（本机 A 软件 + GaussianBeam 两扇窗口）：
                //      方式                  DPI不感知窗口   DPI感知窗口
                //      GDI                      50% ❌        100% ✅
                //      FramePool               100% ✅        100% ✅   ← 用这个
                //      DXGI_DesktopDup         100% ✅        100% ✅   （但尺寸会变，慎用）
                //      DXGI_DesktopDup_Window  100% ✅        100% ✅
                //      PrintWindow              50% ❌        100% ✅
                //      ScreenDC                100% ✅        100% ✅
                //      Background(18)           50% ❌        100% ✅
                //
                //    已验证：换 FramePool 后截图尺寸仍是 1331x720，
                //    Temperature / Setting 的坐标和 PrintWindow 完全一致。
                //    万一新软件用 FramePool 截不到，依次试 ScreenDC、DXGI_DesktopDup_Window。
                "screencap": "FramePool",
                "mouse": "PostMessageWithCursorPos", // 鼠标控制方式
                "keyboard": "PostMessageWithCursorPos" // 键盘控制方式
            }
        }
    ],

    "resource": [
        {
            "name": "默认",
            "path": [
                "./resource"
            ]
        }
    ],

    // ======================================================================
    //  任务分组（PI v2.4.0）：把左侧任务列表按用途分开，避免一大串平铺。
    //  group 只是展示层元数据，不影响任务执行顺序。
    // ======================================================================
    "group": [
        {
            "name": "扫描",
            "label": "扫描",
            "description": "激光参数扫描、打开输出文件夹",
            "default_expand": true
        },
        {
            "name": "邮件与工具",
            "label": "邮件与工具",
            "description": "邮件通知、邮件测试",
            "default_expand": true
        },
        {
            "name": "绘图",
            "label": "绘图",
            "description": "把扫描结果画成曲线图",
            "default_expand": true
        }
    ],

    // ======================================================================
    //  AgentServer：自定义识别 / 自定义动作跑在这个 Python 子进程里
    //  对应仓库根目录的 agent/main.py，实现在 agent/laser_sweep.py
    //
    //  ⚠️ 路径写成 ../agent/main.py 是必须的，不是笔误：
    //     子进程的 CWD 是「interface.json 所在目录」，也就是 assets/，
    //     而 agent/ 在仓库根目录，所以要从 assets/ 往上走一级。
    //     （模板自带的示例写 ./agent/main.py，那只适用于打包后的 install/ 布局）
    //
    //  打包时 tools/install.py 会自动改写这两处：
    //     child_args → ./agent/main.py
    //     child_exec → ./python/python.exe （随包附带的便携版 Python）
    // ======================================================================
    "agent": {
        "child_exec": "python",
        "child_args": [
            "../agent/main.py"
        ]
    },

    // ======================================================================
    //  任务
    // ======================================================================
    "task": [
        {
            // 主任务：只保留扫描本身需要的设置。
            //
            // 2026-10-28：主任务不再挂「邮件设置」。
            //   邮件账号/授权码/收件人只在「邮件通知」任务里填一份，agent 会在
            //   每次扫描开始时直接去读那份配置（见 _load_mail_settings_from_email_task），
            //   所以主任务界面不会再出现一大坨邮件输入框，也不需要用户填两遍。
            "name": "激光参数扫描",
            "entry": "LaserSweepStart",
            "group": [
                "扫描"
            ],
            "option": [
                "扫描设置",
                "读数校验",
                "读数采样"
            ]
        },
        {
            // 扫描结束后发一封「任务完成」通知邮件（2026-10-27 新增）。
            // **全项目唯一填写邮件信息的地方**：邮件通知、邮件测试、读数异常告警
            // 都直接复用这里的设置。
            "name": "邮件通知",
            "entry": "LaserSweepSendSummary",
            "group": [
                "邮件与工具"
            ],
            "option": [
                "邮件设置"
            ]
        },
        {
            // 「打开输出文件夹」按钮：勾上它、点开始，就只是弹出 output 文件夹。
            // （协议 V2 的 option 没有 button 类型，所以用「一个什么都不做的任务」充当按钮）
            //
            // 它**故意不挂任何 option**：输出位置只由「激光参数扫描」的「扫描设置」决定，
            // 免得两个任务各存一份设置、改了一个另一个还开着旧目录。
            // agent 会把最近一次实际用过的 output 目录记在
            // laser_sweep_output.json 里，这个任务就打开那一个
            // （从没跑过扫描时兜底成软件目录下的 output/）。
            "name": "打开输出文件夹",
            "entry": "LaserSweepOpenOutput",
            "group": [
                "扫描"
            ]
        },
        {
            // 「邮件测试」：立刻发一封测试信，验证「邮件通知」任务里的配置对不对。
            //
            // 它不挂任何 option —— 填邮件信息请去「邮件通知」任务；这里只保留一个按钮，
            // 避免同一个配置在多个任务里各存一份、改了一个另一个还是旧值。
            "name": "邮件测试",
            "entry": "LaserSweepMailTest",
            "group": [
                "邮件与工具"
            ]
        },
        {
            // 「绘制曲线图」：独立任务（2026-10-28 新增）。
            // 把扫描导出的 CSV 画成曲线图：X 轴 = 温度（CSV 的「设定参数」列），
            // Y 轴 = B 软件读数 / 输出功率（CSV 的「B软件测量值」列），
            // PNG 保存到 CSV 同级目录。默认自动选**最近导出的单个 CSV**。
            //
            // 它完全不依赖扫描是否正在跑 / 刚跑完：只要磁盘上有 CSV 就能用。
            "name": "绘制曲线图",
            "entry": "LaserSweepPlotCurve",
            "group": [
                "绘图"
            ],
            "option": [
                "绘图设置"
            ]
        }
    ],

    // ======================================================================
    //  可配置项（会显示在 UI 上让用户填写）
    // ======================================================================
    "option": {
        // ==================================================================
        //  折叠式分组（2026-10-28）：
        //  checkbox 的 case 就是「展开设置」按钮；选中时才递归显示
        //  case.option 里列出的子 option。三项默认都不展开，界面更简洁。
        //  ⚠️ 子 option 里仍然保留完整的 pipeline_override：
        //     展开时由 MFA 正常传入；折叠时 agent 会从任务配置里读取同一份设置，
        //     所以折叠只是隐藏输入框，不会把设置变回默认值。
        // ==================================================================
        "扫描设置": {
            "type": "checkbox",
            "label": "扫描设置（范围与输出）",
            "description": "点击「展开设置」按钮，查看并修改扫描范围、每轮等待时间和结果保存位置。再点一次收起。",
            "cases": [
                {
                    "name": "展开设置",
                    "label": "展开设置",
                    "description": "展开/收起本组扫描参数",
                    "option": [
                        "扫描设置项"
                    ]
                }
            ]
        },
        "读数校验": {
            "type": "checkbox",
            "label": "读数校验与异常处理",
            "description": "点击「展开设置」按钮，查看并修改读数校验、重测和异常处理设置。",
            "cases": [
                {
                    "name": "展开设置",
                    "label": "展开设置",
                    "description": "展开/收起读数校验设置",
                    "option": [
                        "读数校验项"
                    ]
                }
            ]
        },
        "读数采样": {
            "type": "checkbox",
            "label": "读数采样",
            "description": "点击「展开设置」按钮，查看并修改采样开关和采样时长。",
            "cases": [
                {
                    "name": "展开设置",
                    "label": "展开设置",
                    "description": "展开/收起读数采样设置",
                    "option": [
                        "读数采样项"
                    ]
                }
            ]
        },
        "扫描设置项": {
            "type": "input",
            "label": "扫描参数与输出",
            "description": "扫描范围、每轮等待时间和结果保存位置。",
            "inputs": [
                {
                    "name": "起始值",
                    "label": "起始值",
                    "description": "从哪个数值开始扫描",
                    "default": "20",
                    // 允许整数和小数（含负号）
                    "verify": "^-?\\d+(?:\\.\\d+)?$",
                    "pattern_msg": "请填数字，例如 20 或 20.5"
                },
                {
                    "name": "结束值",
                    "label": "结束值",
                    "description": "扫描到哪个数值为止（含这个值）",
                    "default": "30",
                    "verify": "^-?\\d+(?:\\.\\d+)?$",
                    "pattern_msg": "请填数字，例如 30"
                },
                {
                    "name": "步长",
                    "label": "步长",
                    "description": "**只有「扫描点数」填 0 时才用它**。每一步增加多少：填 1 就是 20,21,22…；填 0.5 也行",
                    "default": "1",
                    "verify": "^\\d+(?:\\.\\d+)?$",
                    "pattern_msg": "请填正数，例如 1 或 0.5"
                },
                {
                    "name": "扫描点数",
                    "label": "扫描点数",
                    "description": "一共扫几个点。填 0（默认）就按上面的步长算；填 >0 就以点数为准，步长自动反算（此时忽略「步长」）。例：20→30 填 11 = 步长 1；填 6 = 每步 2；填 1 = 只扫起始值",
                    "default": "0",
                    "verify": "^\\d+$",
                    "pattern_msg": "请填 0 或正整数，例如 0（按步长）、11（共 11 个点）"
                },
                {
                    "name": "等待秒数",
                    "label": "每轮等待秒数",
                    "description": "在 A 软件里设好参数后，等多久再去 B 软件读数",
                    "default": "10",
                    "verify": "^\\d+$",
                    "pattern_msg": "请填非负整数，例如 10"
                },
                // ===== 输出设置 =====
                {
                    "name": "结果文件夹名",
                    "label": "结果文件夹名",
                    "description": "本次扫描的结果放在 output 下的哪个子文件夹。留空 = 用系统时间命名（如 20261016_110530_output，同一台机器连跑多次也不会互相覆盖）。也可以自己起名，如「升温测试」，还能写时间占位符：%Y%m%d、{date}、{time}、{datetime}",
                    "default": ""
                },
                {
                    "name": "结果文件名",
                    "label": "结果文件名",
                    "description": "CSV 文件名。留空（默认）= 自动用「时间_起始值_终止值_总点数」命名，例如 20261016_143435_20_30_11，光看名字就知道扫了什么；也可以自己起名，同样支持 %Y%m%d、{date}、{time}、{datetime} 等时间占位符。不写 .csv 会自动补上",
                    "default": ""
                },
                {
                    "name": "跑完自动打开",
                    "label": "跑完自动打开文件夹",
                    "description": "扫描结束后自动弹出 output 文件夹；不想被打扰就关掉（之后可用「打开输出文件夹」任务手动打开）",
                    "default": "true",
                    "pipeline_type": "bool"
                },
                {
                    "name": "输出总目录",
                    "label": "输出总目录（一般不用改）",
                    "description": "所有扫描结果的上级目录，默认 output（就在软件所在文件夹里）。想全部存到别处就填绝对路径，如 D:\\扫描数据",
                    "default": "output"
                }
            ],
            // 用户填的值会通过 {名称} 占位符替换到这里
            //
            // ⚠️ 这里把 custom_action_param 的**全部字段**都写全了：
            //    pipeline_override 对对象是「整体替换」而不是逐字段合并，
            //    少写一个字段就会把它从原 pipeline 里抹掉。
            //
            // ⚠️ 输出相关的三个节点要一起覆盖：
            //    LaserSweepStart      —— 扫描开始时算路径、建 CSV
            //    LaserSweepDone       —— 收尾时决定要不要自动打开文件夹
            //    LaserSweepOpenOutput —— 「打开输出文件夹」任务要打开哪个目录
            //    三个都拿到同一份用户设置，才不会出现「按钮打开的是旧目录」。
            //
            // ⚠️ 2026-10-28 起这里**不再有** smtp_* / mail_to 这些字段：
            //    邮件参数只在「邮件通知」任务的「邮件设置」里维护，agent 会自动读取。
            //    读数校验/采样参数也各自搬到独立 option（读数校验、读数采样）里。
            "pipeline_override": {
                "LaserSweepStart": {
                    "custom_action_param": {
                        "start": "{起始值}",
                        "end": "{结束值}",
                        "step": "{步长}",
                        "count": "{扫描点数}",
                        "wait_sec": "{等待秒数}",
                        "csv_dir": "{结果文件夹名}",
                        "csv_name": "{结果文件名}",
                        "output_root": "{输出总目录}",
                        "open_when_done": "{跑完自动打开}",
                        "csv_header": [
                            "序号",
                            "设定参数",
                            "B软件测量值",
                            "时间",
                            "备注"
                        ]
                    }
                },
                "LaserSweepDone": {
                    "custom_action_param": {
                        "open_when_done": "{跑完自动打开}"
                    }
                },
                "LaserSweepOpenOutput": {
                    "custom_action_param": {
                        "csv_dir": "{结果文件夹名}",
                        "output_root": "{输出总目录}"
                    }
                }
            }
        },
        // ======================================================================
        //  「读数校验」—— 2026-10-28 从「扫描设置」里拆出来的独立分组
        //
        //  为什么要拆：原来 19 个输入项全挤在「扫描设置」一屏里，UI 上又长又乱。
        //  这里只放「读数可不可信、异常了怎么办」相关的选项，属于独立的判断层，
        //  与扫描范围/输出位置互不影响。pipeline_override 也只覆盖 Guard 相关节点，
        //  和「扫描设置」的 LaserSweepStart 不冲突。
        // ======================================================================
        "读数校验项": {
            "type": "input",
            "label": "读数校验参数",
            "description": "判断读数是否可信，以及连续异常时继续扫描还是停下。",
            "inputs": [
                {
                    "name": "读数校验",
                    "label": "开启读数校验与自动重测",
                    "description": "开启后，每个读数都会和上一个读数比较；偏差过大就等几秒重读，而不是直接写进 CSV。关掉 = 退回旧行为（读到什么记什么），排查「是不是误判」时可以先关。",
                    "default": "true",
                    "pipeline_type": "bool"
                },
                {
                    "name": "绝对偏差阈值",
                    "label": "允许的绝对偏差",
                    "description": "和上一个有效读数的差值在这个范围内就算正常。**和「相对偏差阈值」是「取更宽松者」的关系**：两项都被超过才算异常。\n\n**默认 3.0**：宁可漏掉一次偶发误读，也不要因为阈值太紧误杀真实波动。实测正常波动约 0.04，3.0 是它的 75 倍；而「认错一位数字」这类误读动辄偏 5 以上，照样抓得住。",
                    "default": "3.0",
                    "verify": "^\\d+(?:\\.\\d+)?$",
                    "pattern_msg": "请填正数，例如 3.0 或 1.0"
                },
                {
                    "name": "相对偏差阈值",
                    "label": "允许的相对偏差(%)",
                    "description": "相对上一个读数的百分比偏差，填 1 就是 1%。和「绝对偏差阈值」是**「取更宽松者」**的关系：一项在范围内就算正常。填 0 表示不用这一项（只看绝对偏差）。",
                    "default": "1",
                    "verify": "^\\d+(?:\\.\\d+)?$",
                    "pattern_msg": "请填百分比数值，例如 1 表示 1%"
                },
                {
                    "name": "重测等待秒数",
                    "label": "读数异常后等多久再读",
                    "description": "判为异常后先等这么久（让设备恢复/稳定），再读**同一个参数点**一次。一次重测大约多花「这个秒数 + 读一次 B 软件（约 5.5 秒）」，正常读数不花额外时间。",
                    "default": "3",
                    "verify": "^\\d+$",
                    "pattern_msg": "请填非负整数秒数，例如 3"
                },
                {
                    "name": "连续异常次数",
                    "label": "连续几次异常就处理",
                    "description": "**连续**这么多次都读不回来，就认为这个点确实废了：发一封告警邮件，当前这组写成空值占位（保证行号仍和参数一一对应）。中间只要有一次读数恢复正常，计数就清零。",
                    "default": "5",
                    "verify": "^[1-9]\\d*$",
                    "pattern_msg": "请填正整数，例如 5"
                },
                {
                    "name": "异常后继续测试",
                    "label": "出现异常后继续测试",
                    "description": "**勾上（默认）**：连续异常达到上限后，发完告警邮件就把这一组记空值，**继续扫下一个点**，整轮能跑完。\n\n**取消勾选**：发完告警邮件就**终止整个扫描**（旧行为）。\n\n⚠️ 两种都会发告警邮件，区别只在要不要停下。",
                    "default": "true",
                    "pipeline_type": "bool"
                },
                {
                    "name": "读数异常发送邮件",
                    "label": "读数异常时发送邮件",
                    "description": "勾上（默认）：连续多次读数异常时发一封告警邮件。\n\n取消勾选：只写日志、不发邮件。\n\n⚠️ 发信所需的账号/授权码/收件人不在本任务里填，统一在「邮件通知」任务的「邮件设置」里配置；本任务会自动读取那份配置。",
                    "default": "true",
                    "pipeline_type": "bool"
                }
            ],
            "pipeline_override": {
                "LaserSweepGuard": {
                    "custom_action_param": {
                        "enabled": "{读数校验}",
                        "tolerance_abs": "{绝对偏差阈值}",
                        "tolerance_pct": "{相对偏差阈值}",
                        "retry_wait": "{重测等待秒数}",
                        "retry_max": "{连续异常次数}",
                        "retry_node": "LaserSweepRetryValue",
                        "record_node": "LaserSweepRecord",
                        "stop_node": "LaserSweepAbnormalStop",
                        "wait_node": "LaserSweepWaitSettle",
                        "notify_enabled": "{读数异常发送邮件}",
                        "continue_on_abnormal": "{异常后继续测试}"
                    }
                },
                "LaserSweepAbnormalStop": {
                    "custom_action_param": {
                        "retry_max": "{连续异常次数}"
                    }
                }
            }
        },
        // ======================================================================
        //  「读数采样」—— 2026-10-28 从「扫描设置」里拆出来的独立分组
        //
        //  只保留「每个点读多久、读几次」这两项。采样是识别层的事，和扫描范围、
        //  异常判定都无关；单独一组后主任务界面会短很多，也不会把采样参数
        //  和校验参数混在一起。
        // ======================================================================
        "读数采样项": {
            "type": "input",
            "label": "采样参数",
            "description": "每个参数点在一小段时间里反复读数、取平均，压掉 B 软件的刷新抖动。",
            "inputs": [
                {
                    "name": "读数采样",
                    "label": "多点采样取平均",
                    "description": "勾上（默认）：每个参数点在一小段时间里**反复读数**，取平均值写进 CSV。\n\n取消勾选：退回旧行为，每个点只读一次。\n\n⚠️ 影响的是**采样**，不是**校验**：校验看的是这个平均值。",
                    "default": "true",
                    "pipeline_type": "bool"
                },
                {
                    "name": "采样时长",
                    "label": "每个点采样多少秒",
                    "description": "在这个时间窗里反复读数，读几次由 OCR 实际速度决定，最后取平均。\n\n**默认 1 秒**：仪表一般 100~500 毫秒刷新一帧，1 秒能覆盖三四帧，足够把抖动平均掉；再长会把设备真实的爬升也抹平，整轮扫描也会明显变慢。\n\n填 0 = 只读一次（和关掉采样等效）。",
                    "default": "1",
                    "verify": "^\\d+(?:\\.\\d+)?$",
                    "pattern_msg": "请填秒数，例如 1（支持小数，如 0.5）"
                }
            ],
            "pipeline_override": {
                "LaserSweepReadValueB": {
                    "custom_recognition_param": {
                        "mode": "ocr",
                        "fixed_value": 0.0,
                        "window_regex": "^(GaussianBeam|光器件耦合系统.*)$",
                        "window_index": 0,
                        "anchor_text": ["功率CH1", "Wavelength"],
                        "roi": [0, 0, 0, 0],
                        "pattern": "[-+]?\\d+(?:\\.\\d+)?",
                        "value_max_chars": 24,
                        "min_digit_ratio": 0.3,
                        "anchor_max_chars": 16,
                        "ocr_node": "LaserSweepOcrValueB",
                        "only_rec": false,
                        "sample_enabled": "{读数采样}",
                        "sample_window_sec": "{采样时长}",
                        "sample_max_count": 60,
                        "sample_slow_sec": 5,
                        "sample_roi_pad": 8,
                        "sample_ocr_node": "LaserSweepOcrValueB",
                        "sample_outlier_abs": 3.0,
                        "sample_outlier_pct": 1
                    }
                }
            }
        },
        // ======================================================================
        //  「邮件设置」—— 全项目唯一填写邮件信息的地方（2026-10-28 起）
        //
        //  谁在用这份配置：
        //    · 「邮件通知」任务  —— 扫描结束后发汇总信
        //    · 「邮件测试」任务  —— 立刻发一封测试信，验证配置（没有自己的输入项）
        //    · 「激光参数扫描」任务 —— 读数异常告警时，agent 自动读取本任务的设置
        //  所以用户只需要在这里填一次，主任务和邮件测试都不会再出现重复输入框。
        //
        //  ⚠️ 授权码不写在这里（password 字段不能有 default，也不该出现在
        //     会入库的 JSON 里）。它只在 config/laser_sweep_mail.json 里，
        //     界面上留空即可，agent 会自动去读那份本地文件。
        // ======================================================================
        "邮件设置": {
            "type": "input",
            "label": "邮件设置",
            "description": "全项目唯一需要填写邮件信息的地方。其他任务会自动读取这里的配置，不需要重复填写。",
            "inputs": [
                {
                    "name": "发送完成通知",
                    "label": "扫描结束后发送完成通知",
                    "description": "勾上：跑完「邮件通知」任务时，给这次扫描的结果发一封汇总信（扫了几组、成功几组、哪些行是空值、耗时、文件路径）。\n\n取消勾选：那个任务只是空跑一遍，不发信。\n\n⚠️ 这个开关只管「完成通知」，不影响读数异常时的告警邮件（那个去扫描任务的「读数异常发送邮件」里开关）。",
                    "default": "true",
                    "pipeline_type": "bool"
                },
                {
                    "name": "收件邮箱",
                    "label": "收件邮箱",
                    "description": "通知发到哪里。多个地址用**英文逗号**分隔。可以和发件邮箱填同一个（自己发给自己）。\n\n留空 = 不发信（会退化成只写日志）。",
                    "default": "",
                    // 空字符串是合法值（表示不发），所以正则里要留一个 ^$ 分支，
                    // 否则用户不填就会被红字拦下，任务根本起不来
                    "verify": "^$|^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
                    "pattern_msg": "留空，或填完整邮箱地址，如 you@example.com"
                },
                {
                    "name": "SMTP账号",
                    "label": "发件邮箱（SMTP 账号）",
                    "description": "用哪个邮箱发信。填**完整邮箱地址**，如 `yourname@qq.com`（QQ 邮箱的 SMTP 用户名就是完整地址）。",
                    "default": "",
                    "verify": "^$|^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
                    "pattern_msg": "留空，或填完整邮箱地址，如 yourname@qq.com"
                },
                {
                    "name": "SMTP密码",
                    "label": "SMTP 密码/授权码",
                    // password: true → 界面上掩码显示、不写日志。
                    // ⚠️ 协议 v2.10.0 规定：password 为 true 时**禁止**再给 default，
                    //    两者同时出现 schema 校验直接 fail（schema 里有 if/then 断言），
                    //    所以这一项故意没有 default。
                    "password": true,
                    "description": "这里填的是**授权码**，不是邮箱登录密码。\n\n**为什么不是登录密码**：QQ/163 等邮箱在开启了两步验证后，登录密码根本无法用于第三方客户端发信；服务商专门发放一串「授权码/SMTP 密码」给程序用，而且它能随时单独作废，不影响你平时登录。\n\n**QQ 邮箱怎么拿**（默认 smtp.qq.com:465）：网页版邮箱 →「设置」→「账号与安全」→「安全设置」→ 开启「SMTP 服务」（需短信验证）→「生成授权码」，得到一串 16 位字符，填到这里即可。\n\n**163 邮箱**：网页版 →「设置」→「POP3/SMTP/IMAP」→ 开启 SMTP 服务 → 设置客户端授权密码。\n\n**腾讯企业邮/企业微信邮箱**：管理后台为账号开启「客户端专用密码」，服务器用 `smtp.exmail.qq.com`（同样是 465 + SSL）。\n\n⚠️ 授权码只显示一次，拿到就先粘到记事本备份。也**不要**把它贴着发到群里。\n\n💡 **留空也能发**：授权码保存在本机的 `config/laser_sweep_mail.json` 里（该文件不入库、不进 Git），程序会自动去读。所以界面上这一项留空即可；填了就以界面为准。"
                },
                {
                    "name": "SMTP服务器",
                    "label": "SMTP 服务器",
                    "description": "默认 `smtp.qq.com`（QQ 邮箱）。163 用 `smtp.163.com`，腾讯企业邮/企业微信邮箱用 `smtp.exmail.qq.com`，学校/单位邮箱请查该邮箱的「客户端设置」帮助页。",
                    "default": "smtp.qq.com"
                },
                {
                    "name": "SMTP端口",
                    "label": "SMTP 端口",
                    "description": "默认 465（SSL 直连，推荐）。本程序固定按 SSL 连接，所以 25/587 这类非 SSL 或 STARTTLS 端口通常连不上；公司网络封了 465 时，可以先用手机热点验证是不是网络的问题（发信失败只会记日志，不影响任务本身）。",
                    "default": "465",
                    "verify": "^\\d+$",
                    "pattern_msg": "请填数字端口，例如 465"
                },
                {
                    "name": "邮件主题前缀",
                    "label": "邮件主题前缀",
                    "description": "邮件标题的前缀，后面会自动拼上「任务完成：…」或「读数异常告警：…」。想用邮箱规则自动分拣到「激光扫描」文件夹时，就靠这个前缀识别。",
                    "default": "[激光扫描]"
                },
                {
                    "name": "通知方式",
                    "label": "通知方式",
                    "description": "三种取值（小写）：\n\n- `auto`：配了收件邮箱 + SMTP 账号就发，没配就只写日志，不会报错；\n- `email`（默认）：强制发信，配错了会在日志里写明原因（但不影响任务本身）；\n- `off`：只写日志，不发信。\n\n⚠️ 默认 `email`：本机已配好可用账号，用 `email` 能让「配错了」立刻暴露在日志里，而不是静默退化成只写日志、等你以为会收到信时才发现没收到。",
                    "default": "email",
                    // 故意不放行 mail：agent 只认 email/auto/off，放行会变成校验通过但静默不生效
                    "verify": "^(auto|email|off)$",
                    "pattern_msg": "请填 auto、email 或 off（小写）"
                },
                {
                    "name": "每次最多通知",
                    "label": "一次任务最多发几封",
                    "description": "防止反复触发把邮箱刷爆。填 1（默认）= 只发第一封；填 0 = 一封都不发（只写日志）。",
                    "default": "1",
                    "verify": "^\\d+$",
                    "pattern_msg": "请填非负整数，例如 1"
                }
            ],
            "pipeline_override": {
                // ⚠️⚠️ 这里**绝对不能**再写 LaserSweepStart！
                //
                //   2026-10-27 的严重 bug 就是这么来的：扫描任务同时挂
                //   「扫描设置」和「邮件设置」，两份 override 都写 LaserSweepStart，
                //   而 override 对 custom_action_param 是**整体替换** ——
                //   后应用的那份把起始值/结束值/步长全顶掉了，agent 退回代码默认
                //   20→30，用户怎么调界面都从 20 开始扫。
                //
                //   现在 LaserSweepStart 只由「扫描设置」覆盖；本份 override 只负责
                //   「邮件通知」任务的发信参数。「邮件测试」任务不挂 option，
                //   agent 会直接读取「邮件通知」任务的这份配置。
                //   tools/check_sample.py 有一条断言专门盯"同一节点不许被两处覆盖"。
                "LaserSweepSendSummary": {
                    "custom_action_param": {
                        "enabled": "{发送完成通知}",
                        "notify_mode": "{通知方式}",
                        "smtp_host": "{SMTP服务器}",
                        "smtp_port": "{SMTP端口}",
                        "smtp_ssl": true,
                        "smtp_user": "{SMTP账号}",
                        "smtp_password": "{SMTP密码}",
                        "mail_to": "{收件邮箱}",
                        "mail_subject_prefix": "{邮件主题前缀}",
                        "notify_limit": "{每次最多通知}",
                        "timeout_sec": 20
                    }
                }
            }
        },
        // ==================================================================
        //  「绘图设置」—— 「绘制曲线图」任务的输入项（2026-10-28 新增）
        //
        //  这是**独立任务**：不挂在「激光参数扫描」上，也不影响扫描流程。
        //  默认留空就能用：agent 会自动选最近导出的单个 CSV（见 _resolve_plot_csv）。
        //  只有想画某一份旧数据时，才需要在这里填路径。
        // ==================================================================
        "绘图设置": {
            "type": "input",
            "label": "绘图设置",
            "description": "把扫描导出的 CSV 画成曲线图（温度 / 输出功率），PNG 保存在 CSV 同目录。",
            "inputs": [
                {
                    "name": "CSV文件",
                    "label": "CSV 文件（留空 = 最近导出的一个）",
                    "description": "要画的 CSV。**留空（默认）** = 自动选最近导出的单个 CSV：优先本次扫描，其次上次扫描记录的路径，最后在 output 目录里取修改时间最新的一个。\n\n也可以填具体的 CSV 路径（相对路径按软件目录算），或者填一个**目录** —— 会画该目录里最新的 CSV。",
                    "default": ""
                },
                {
                    "name": "图片文件名",
                    "label": "图片文件名（留空 = <CSV 名>_曲线.png）",
                    "description": "生成的图片文件名，必须和 CSV 在同一个文件夹（目录由 CSV 决定，不在这里填）。留空 = 与 CSV 同名加 `_曲线.png`，例如 `20261028_200000_20_30_11_曲线.png`。支持 %Y%m%d、{date}、{time}、{datetime} 时间占位符；不是 .png 会自动补成 .png。",
                    "default": ""
                },
                {
                    "name": "完成后打开图片",
                    "label": "绘制完成后打开图片",
                    "description": "勾上（默认）：画完用系统默认看图软件打开，结果立刻能看到。取消勾选：只在日志里打印图片路径。",
                    "default": "true",
                    "pipeline_type": "bool"
                }
            ],
            // ⚠️ override 对 custom_action_param 是整体替换：
            //    这里的字段集合必须与 my_task.json 的 LaserSweepPlotCurve 默认值完全一致。
            "pipeline_override": {
                "LaserSweepPlotCurve": {
                    "custom_action_param": {
                        "source_csv": "{CSV文件}",
                        "image_name": "{图片文件名}",
                        "open_when_done": "{完成后打开图片}"
                    }
                }
            }
        }
    }
}
