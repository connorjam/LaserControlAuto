{
    // 本文件定义了通用 UI（MFAAvalonia / MXU 等）的行为和显示内容
    // 文档：https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    "interface_version": 2,
    "name": "LaserControlAuto",
    "label": "激光控制自动化",
    "description": "在低噪声驱动调试软件里自动设置参数，等待稳定后到测量软件读取数值，逐点记录到 CSV。",
    "license": "MIT",
    // ⚠️ welcome 只能写成「一个字符串」，千万别写成字符串数组 ["...", "..."]。
    //    2026-09-22 踩过的坑：
    //      协议 v2.10.2 起确实允许数组写法，本文件的 schema 校验也放行，
    //      但 MFAAvalonia v2.16.1 的 MaaWelcomeConverter 只认「字符串」和
    //      「对象数组」（元素形如 {"label": "...", "content": "..."}）。
    //      写成字符串数组会抛：
    //          Newtonsoft.Json.JsonSerializationException:
    //          welcome announcement entries must be objects.
    //      后果是整个 interface.json 加载失败 —— 界面上「任务列表」一片空白、
    //      点「+」也没有任务可加、日志区红字「文件 interface.json 加载失败！」。
    //    要写多条公告，就全塞进这一个字符串里，中间用 --- 分隔。
    //    tools/install.py 里已经加了自检：真写成数组会在打包时自动降级并告警。
    "welcome": "## 使用前请先确认\n\n1. **A 软件**（要设置参数的那个）已经打开，并且停在含目标参数的那一页。\n2. **B 软件**（要读数值的那个）也已经打开。\n3. 在下面的「扫描设置」里填好**起始值 / 结束值**，以及**步长**或**扫描点数**（二选一，点数填 0 就走步长），还有**输出文件夹**。\n\n点「开始任务」后程序会自动完成整个扫描，期间请不要用手去动鼠标键盘。\n\n结果会保存成 CSV 文件，路径在运行日志里会打印出来。",
    "version": "1.0.0",
    "contact": "https://github.com/connorjam/LaserControlAuto",
    "github": "https://github.com/connorjam/LaserControlAuto",

    // ======================================================================
    //  控制器
    //  ⚠️ Win32 控制器一次只能绑定一个窗口，截图和点击都只作用于它。
    //     这里绑定的是「A 软件」；B 软件由 agent 自己另外截图（见 agent/laser_sweep.py）。
    // ======================================================================
    "controller": [
        {
            "name": "桌面端",
            "type": "Win32",
            "win32": {
                "class_regex": ".*",
                // A 软件（Low_Noise_Drive_Debugger_V2.13.exe）的窗口标题，实测为：
                //     Low Noise Driver Debugger V2.13        （class = Qt5QWindowIcon）
                // 用 \s+ 匹配空格，标题里的版本号变了也不影响。
                "window_regex": "Low\\s+Noise\\s+Driver\\s+Debugger",
                // 截图方式。文档: https://maafw.xyz/docs/2.4-ControlMethods
                //
                // ⚠️ 用 FramePool，不要用 PrintWindow / Background：
                //    PrintWindow 遇到「DPI 不感知」的程序（窗口 DPI=96）时，
                //    只会渲染出左上角 1/4 的画面，内容占比 50%，OCR 直接废掉。
                //    Background(=FramePool|PrintWindow) 也不行——框架是「挑最快的」，
                //    实测它会选中 PrintWindow(32ms)，照样坏。
                //
                //    实测（本机 A 软件 + GaussianBeam 两扇窗口）：
                //      方式                  DPI不感知窗口   DPI感知窗口
                //      GDI                      50% ❌        100% ✅
                //      FramePool               100% ✅        100% ✅   ← 用这个
                //      DXGI_DesktopDup         100% ✅        100% ✅   （但尺寸会变，慎用）
                //      DXGI_DesktopDup_Window  100% ✅        100% ✅
                //      PrintWindow              50% ❌        100% ✅
                //      ScreenDC                100% ✅        100% ✅
                //      Background(18)           50% ❌        100% ✅
                //
                //    已验证：换 FramePool 后截图尺寸仍是 1331x720，
                //    Temperature / Setting 的坐标和 PrintWindow 完全一致。
                //    万一新软件用 FramePool 截不到，依次试 ScreenDC、DXGI_DesktopDup_Window。
                "screencap": "FramePool",
                "mouse": "PostMessageWithCursorPos", // 鼠标控制方式
                "keyboard": "PostMessageWithCursorPos" // 键盘控制方式
            }
        }
    ],

    "resource": [
        {
            "name": "默认",
            "path": [
                "./resource"
            ]
        }
    ],

    // ======================================================================
    //  AgentServer：自定义识别 / 自定义动作跑在这个 Python 子进程里
    //  对应仓库根目录的 agent/main.py，实现在 agent/laser_sweep.py
    //
    //  ⚠️ 路径写成 ../agent/main.py 是必须的，不是笔误：
    //     子进程的 CWD 是「interface.json 所在目录」，也就是 assets/，
    //     而 agent/ 在仓库根目录，所以要从 assets/ 往上走一级。
    //     （模板自带的示例写 ./agent/main.py，那只适用于打包后的 install/ 布局）
    //
    //  打包时 tools/install.py 会自动改写这两处：
    //     child_args → ./agent/main.py
    //     child_exec → ./python/python.exe （随包附带的便携版 Python）
    // ======================================================================
    "agent": {
        "child_exec": "python",
        "child_args": [
            "../agent/main.py"
        ]
    },

    // ======================================================================
    //  任务
    // ======================================================================
    "task": [
        {
            "name": "激光参数扫描",
            "entry": "LaserSweepStart",
            "option": [
                "扫描设置",
                // ⚠️ 必须同时挂「邮件设置」（2026-10-27 修）：
                //    告警邮件（连续读数异常时发的那封）走的是扫描任务里的
                //    LaserSweepGuard 节点，而 SMTP 账号/授权码/收件人全部定义在
                //    「邮件设置」这个 option 里。扫描任务不挂它，Guard 拿到的
                //    smtp_* 就全是空字符串 → _send_alert 判"缺配置" → 静默降级
                //    为 off，一封告警都发不出去；而扫描结束的「完成通知」因为
                //    挂在「邮件通知」任务上（那个任务挂了邮件设置），却能正常发出。
                //    症状就是"别的信收得到，偏偏异常告警收不到"，极难自查。
                //
                //    ✅ 挂载它**不会**让用户多填一遍：输入框定义在 option 自己的
                //    inputs 里，同一份「邮件设置」被多个任务共用，填一次全生效。
                //    这里只是让扫描任务也读得到那份配置。
                "邮件设置"
            ]
        },
        {
            // 扫描结束后发一封「任务完成」通知邮件（2026-10-27 新增，主人要求）。
            //
            // 为什么独立成一个任务，而不是塞进「激光参数扫描」：
            //   ① 扫描任务的节点参数越少越好 —— 它会被 pipeline_override 整体替换，
            //      字段越多越容易漏一个（本项目踩过这个坑，漏了就等于把配置抹掉）；
            //   ② 「扫完报个平安」和「读数异常告警」是两件事，混在一起会让
            //      「配置读死了只做告警」这种误解变得很难查；
            //   ③ 邮件参数集中到「邮件设置」里，扫描任务的异常告警读的也是同一份，
            //      改一处全生效。
            //
            // 邮件设置里还有「发送完成通知」开关：关掉它，这个任务就只是空跑一遍
            // （不会往你的邮箱灌信）。想手动补发上一次的结果，直接再点一次本任务即可。
            "name": "邮件通知",
            "entry": "LaserSweepSendSummary",
            "option": [
                "邮件设置"
            ]
        },
        {
            // 「打开输出文件夹」按钮：勾上它、点开始，就只是弹出 output 文件夹。
            // （协议 V2 的 option 没有 button 类型，所以用「一个什么都不做的任务」充当按钮）
            //
            // 它**故意不挂任何 option**：输出位置只由「激光参数扫描」的「扫描设置」决定，
            // 免得两个任务各存一份设置、改了一个另一个还开着旧目录。
            // agent 会把最近一次实际用过的 output 目录记在
            // laser_sweep_output.json 里，这个任务就打开那一个
            // （从没跑过扫描时兜底成软件目录下的 output/）。
            "name": "打开输出文件夹",
            "entry": "LaserSweepOpenOutput"
        },
        {
            // 「邮件测试」：立刻发一封测试信，验证邮件设置对不对。
            //
            // 为什么值得单独一个入口：邮件配错平时完全看不出来，只有等到
            // 「连续 5 次读数异常」那一刻才暴露 —— 而那正是最不该发现
            // 「原来邮件一直发不出去」的时候。所以给一个立刻给结论的自检按钮。
            "name": "邮件测试",
            "entry": "LaserSweepMailTest",
            "option": [
                "邮件设置"
            ]
        }
    ],

    // ======================================================================
    //  可配置项（会显示在 UI 上让用户填写）
    // ======================================================================
    "option": {
        "扫描设置": {
            "type": "input",
            "label": "扫描设置",
            "description": "设置参数扫描的范围、等待时间和结果保存位置。改完直接点开始任务即可生效。",
            "inputs": [
                {
                    "name": "起始值",
                    "label": "起始值",
                    "description": "从哪个数值开始扫描",
                    "default": "20",
                    // 允许整数和小数（含负号）
                    "verify": "^-?\\d+(?:\\.\\d+)?$",
                    "pattern_msg": "请填数字，例如 20 或 20.5"
                },
                {
                    "name": "结束值",
                    "label": "结束值",
                    "description": "扫描到哪个数值为止（含这个值）",
                    "default": "30",
                    "verify": "^-?\\d+(?:\\.\\d+)?$",
                    "pattern_msg": "请填数字，例如 30"
                },
                {
                    "name": "步长",
                    "label": "步长",
                    "description": "**只有「扫描点数」填 0 时才用它**。每一步增加多少：填 1 就是 20,21,22…；填 0.5 也行",
                    "default": "1",
                    "verify": "^\\d+(?:\\.\\d+)?$",
                    "pattern_msg": "请填正数，例如 1 或 0.5"
                },
                {
                    "name": "扫描点数",
                    "label": "扫描点数",
                    "description": "一共扫几个点。填 0（默认）就按上面的步长算；填 >0 就以点数为准，步长自动反算（此时忽略「步长」）。例：20→30 填 11 = 步长 1；填 6 = 每步 2；填 1 = 只扫起始值",
                    "default": "0",
                    "verify": "^\\d+$",
                    "pattern_msg": "请填 0 或正整数，例如 0（按步长）、11（共 11 个点）"
                },
                {
                    "name": "等待秒数",
                    "label": "每轮等待秒数",
                    "description": "在 A 软件里设好参数后，等多久再去 B 软件读数",
                    "default": "10",
                    "verify": "^\\d+$",
                    "pattern_msg": "请填非负整数，例如 10"
                },
                // ==============================================================
                //  读数校验 / 异常重测（2026-10-26 新增）
                //
                //  解决什么问题：OCR 偶尔读错、设备还在爬升、通信偶发失败，
                //  这三类错误**不会**让识别失败（on_error 兜不住），只会安安静静
                //  把离谱的数字写进 CSV。几十上百个点、跑一两个小时没人盯着，
                //  等回头翻表才发现有个点不对，那时已经白跑了。
                //
                //  判定口径：每读到一个值，先和**上一个有效读数**比，
                //      |当前 - 上次| ≤ 绝对偏差阈值   **或**
                //      相对偏差 ≤ 相对偏差阈值(%)
                //  任一满足就算正常（两项取更宽松者：大数值靠百分比、小数值靠绝对值，
                //  宁可漏判也不误杀真实拐点）。两项都超了才去重测。
                //
                //  ⚠️ 下面的 name 一律**不带括号和空格**，label 里才写括号说明。
                //     pipeline_override 里的 {占位符} 是按 name 逐字匹配替换的，
                //     name 里混进括号/空格会让替换落空，值传不到 agent。
                // ==============================================================
                {
                    "name": "读数校验",
                    "label": "开启读数校验与自动重测",
                    "description": "开启后，每个读数都会和上一个读数比较；偏差过大就等几秒重读，而不是直接写进 CSV。关掉 = 退回旧行为（读到什么记什么），排查「是不是误判」时可以先关。",
                    // bool 类型：旧版 MFAAvalonia 会把 true/false 当字符串 "true"/"false"
                    // 传到 agent，agent 那边用 _flag() 解析，保持和「跑完自动打开」一致
                    "default": "true",
                    "pipeline_type": "bool"
                },
                {
                    "name": "绝对偏差阈值",
                    "label": "允许的绝对偏差",
                    "description": "和上一个有效读数的差值在这个范围内就算正常。**和「相对偏差阈值」是「取更宽松者」的关系**：两项都被超过才算异常。\n\n**默认 3.0**（2026-10-27 从 1.0 放宽）：宁可漏掉一次偶发误读，也不要因为阈值太紧误杀真实波动。量级参考——实测正常波动约 0.04，3.0 是它的 75 倍，正常跑绝不会触发；而「认错一位数字」这类误读动辄偏 5 以上（如 -79.72 → -85.3），照样抓得住。",
                    "default": "3.0",
                    "verify": "^\\d+(?:\\.\\d+)?$",
                    "pattern_msg": "请填正数，例如 3.0 或 1.0"
                },
                {
                    "name": "相对偏差阈值",
                    "label": "允许的相对偏差(%)",
                    "description": "相对上一个读数的百分比偏差，填 1 就是 1%。**默认 1**：这是按实测数据定的 —— 20→30 扫 11 组，功率从 -79.72 只漂到 -80.11（整段 0.4），填 10 等于允许 ±7.97，判据永远被这一项放行、等于没开保护。\n\n和「绝对偏差阈值」是**「取更宽松者」**的关系：一项在范围内就算正常。填 0 表示不用这一项（只看绝对偏差）。",
                    "default": "1",
                    "verify": "^\\d+(?:\\.\\d+)?$",
                    "pattern_msg": "请填百分比数值，例如 1 表示 1%"
                },
                {
                    "name": "重测等待秒数",
                    "label": "读数异常后等多久再读",
                    "description": "判为异常后先等这么久（让设备恢复/稳定），再读**同一个参数点**一次。一次重测大约多花「这个秒数 + 读一次 B 软件（约 5.5 秒）」≈ 9 秒；正常读数不花任何额外时间。",
                    "default": "3",
                    "verify": "^\\d+$",
                    "pattern_msg": "请填非负整数秒数，例如 3"
                },
                {
                    "name": "连续异常次数",
                    "label": "连续几次异常就处理",
                    "description": "**连续**这么多次都读不回来，就认为这个点确实废了：发一封告警邮件，当前这组写成空值占位（保证行号仍和参数一一对应）。\n\n之后是继续扫还是停下，由下面的「出现异常后是否继续测试」决定。中间只要有一次读数恢复正常，计数就清零。",
                    "default": "5",
                    // 必须是正整数：填 0 会让保护立刻触发（等于一有异常就处理）
                    "verify": "^[1-9]\\d*$",
                    "pattern_msg": "请填正整数，例如 5"
                },
                {
                    "name": "异常后继续测试",
                    "label": "出现异常后继续测试",
                    "description": "**勾上（默认）**：连续异常达到上限后，发完告警邮件就把这一组记空值，**继续扫下一个点**，整轮能跑完。适合没人盯着、或者收到邮件也不一定有空处理的情况。\n\n**取消勾选**：发完告警邮件就**终止整个扫描**（旧行为）。适合希望一旦数据出问题就别再继续产出的场景。\n\n⚠️ 两种都会发告警邮件，区别只在要不要停下。",
                    "default": "true",
                    "pipeline_type": "bool"
                },
                // ==============================================================
                //  读数采样（2026-10-27 新增）
                //
                //  解决什么问题：B 软件的读数本身在抖 —— 同一组内差 0.05 上下，
                //  和组与组之间的差异同一个量级。原来每个点只读一次，
                //  等于随手抓了其中一个瞬间，曲线上的起伏一半来自读数噪声。
                //
                //  现在的做法：先整屏定位一次数值框（约 5.5 秒，只做一次），
                //  之后在**这个秒数的时间窗**里反复读那一小块，读几次算几次
                //  （OCR 快就多读、慢就少读），最后把**平均值**写进 CSV。
                //
                //  为什么不写死次数：不同机器 OCR 速度能差 5 倍，
                //  写死「读 10 次」在慢机器上会把一轮拖成几分钟。
                //  实际读了多少次会打在日志里（`B 软件 1 秒采样：N 次…`）。
                // ==============================================================
                {
                    "name": "读数采样",
                    "label": "多点采样取平均",
                    "description": "勾上（默认）：每个参数点在一小段时间里**反复读数**，取平均值写进 CSV —— 压掉 B 软件的刷新抖动。\n\n取消勾选：退回旧行为，每个点只读一次。\n\n⚠️ 影响的是**采样**，不是**校验**：校验（和上一个点比、偏差太大就重测）看的是这个平均值。",
                    "default": "true",
                    "pipeline_type": "bool"
                },
                {
                    "name": "采样时长",
                    "label": "每个点采样多少秒",
                    "description": "在这个时间窗里反复读数，读几次由 OCR 实际速度决定，最后取平均。\n\n**默认 1 秒**：仪表一般 100~500 毫秒刷新一帧，1 秒能覆盖三四帧，足够把抖动平均掉；再长会把设备真实的爬升也抹平，整轮扫描也会明显变慢。\n\n填 0 = 只读一次（和关掉采样等效）。",
                    "default": "1",
                    "verify": "^\\d+(?:\\.\\d+)?$",
                    "pattern_msg": "请填秒数，例如 1（支持小数，如 0.5）"
                },
                // ==============================================================
                //  异常通知：这里只剩一个开关（2026-10-27 重构）
                //
                //  账号、授权码、收件人这些全部搬到独立的「邮件设置」里去了 ——
                //  那份配置同时伺候「读数异常告警」和「邮件通知」任务，改一处全生效。
                //  本任务只在「检测到异常时要不要发信」这一点上表态，所以只留一个勾选框。
                //
                //  这样做的好处（也是重构的理由）：
                //    · 扫描任务的节点参数从 19 项降到 11 项，被 pipeline_override
                //      整体替换时漏字段的风险小得多；
                //    · 邮件填错了，不会让「读数检测」本身看起来像出了问题 ——
                //      两者彻底解耦。
                // ==============================================================
                {
                    "name": "读数异常发送邮件",
                    "label": "读数异常时发送邮件",
                    "description": "勾上（默认）：连续多次读数异常、扫描被终止时，发一封告警邮件（内容含总耗时、异常读数、正常值应该在什么范围、结果文件路径）。\n\n取消勾选：只写日志、不发邮件 —— 适合有人盯着屏幕、或者机器连不上外网的时候。\n\n⚠️ 发信所需的账号/授权码/收件人不在这里填，去「邮件设置」里配；两个任务共用同一份。",
                    "default": "true",
                    "pipeline_type": "bool"
                },
                // ===== 下面回到原有的输出设置 =====
                {
                    "name": "结果文件夹名",
                    "label": "结果文件夹名",
                    "description": "本次扫描的结果放在 output 下的哪个子文件夹。留空 = 用系统时间命名（如 20261016_110530_output，同一台机器连跑多次也不会互相覆盖）。也可以自己起名，如「升温测试」，还能写时间占位符：%Y%m%d、{date}、{time}、{datetime}",
                    "default": ""
                },
                {
                    "name": "结果文件名",
                    "label": "结果文件名",
                    "description": "CSV 文件名。留空（默认）= 自动用「时间_起始值_终止值_总点数」命名，例如 20261016_143435_20_30_11，光看名字就知道扫了什么；也可以自己起名，同样支持 %Y%m%d、{date}、{time}、{datetime} 等时间占位符。不写 .csv 会自动补上",
                    "default": ""
                },
                {
                    "name": "跑完自动打开",
                    "label": "跑完自动打开文件夹",
                    "description": "扫描结束后自动弹出 output 文件夹；不想被打扰就关掉（之后可用「打开输出文件夹」任务手动打开）",
                    "default": "true",
                    "pipeline_type": "bool"
                },
                {
                    "name": "输出总目录",
                    "label": "输出总目录（一般不用改）",
                    "description": "所有扫描结果的上级目录，默认 output（就在软件所在文件夹里）。想全部存到别处就填绝对路径，如 D:\\扫描数据",
                    "default": "output"
                }
            ],
            // 用户填的值会通过 {名称} 占位符替换到这里
            //
            // ⚠️ 这里把 custom_action_param 的**全部字段**都写全了：
            //    pipeline_override 对对象是「整体替换」而不是逐字段合并，
            //    少写一个字段就会把它从原 pipeline 里抹掉。
            //
            // ⚠️ 输出相关的三个节点要一起覆盖：
            //    LaserSweepStart   —— 扫描开始时算路径、建 CSV
            //    LaserSweepDone    —— 收尾时决定要不要自动打开文件夹
            //    LaserSweepOpenOutput —— 「打开输出文件夹」任务要打开哪个目录
            //    三个都拿到同一份用户设置，才不会出现「按钮打开的是旧目录」。
            //
            // ⚠️ 读数守卫（LaserSweepGuard）与终止节点（LaserSweepAbnormalStop）
            //    也走同一套「整体替换」，各自把 custom_action_param 写全。
            //
            //    ⚠️ 2026-10-27 起这里**不再有** smtp_* / mail_to 这些字段：
            //       邮件参数搬到独立的「邮件设置」里了，扫描任务只留一个
            //       「读数异常发送邮件」开关（notify_enabled）。
            //       少 12 个字段 = 少 12 个漏写就会被抹掉的机会。
            "pipeline_override": {
                // ==============================================================
                //  读数节点：1 秒窗口多点采样（2026-10-27）
                //
                //  ⚠️ custom_recognition_param **必须整块写全**（19 个字段一个不少）。
                //     pipeline_override 对对象是整体替换 —— 少写 window_regex /
                //     anchor_text / pattern 里任何一个，就等于把它从原 pipeline 里
                //     抹掉，用户看到的是"读数突然读不到了/读错地方了"。
                //     字段集合与 my_task.json 的 LaserSweepReadValueB 完全一致，
                //     改一边必须同步改另一边（tools/check_sample.py 有一条断言
                //     专门盯这个一致性，漂了就红）。
                //
                //  只有两项来自界面（★ 标记），其余是常量，属于调参不该让用户改：
                //      sample_max_count  防呆上限，正常跑碰不到
                //      sample_slow_sec   单次读数超这么久就收手（这台机器 OCR 比窗还慢）
                //      sample_roi_pad    窄 ROI 外扩像素
                //      sample_outlier_*  平均之前先剔误读的"正常带"
                // ==============================================================
                "LaserSweepReadValueB": {
                    "custom_recognition_param": {
                        "mode": "ocr",
                        "fixed_value": 0.0,
                        "window_regex": "^(GaussianBeam|光器件耦合系统.*)$",
                        "window_index": 0,
                        "anchor_text": ["功率CH1", "Wavelength"],
                        "roi": [0, 0, 0, 0],
                        "pattern": "[-+]?\\d+(?:\\.\\d+)?",
                        "value_max_chars": 24,
                        "min_digit_ratio": 0.3,
                        "anchor_max_chars": 16,
                        "ocr_node": "LaserSweepOcrValueB",
                        "only_rec": false,
                        // ★ 来自界面
                        "sample_enabled": "{读数采样}",
                        "sample_window_sec": "{采样时长}",
                        // 常量（与 my_task.json 一致）
                        "sample_max_count": 60,
                        "sample_slow_sec": 5,
                        "sample_roi_pad": 8,
                        "sample_ocr_node": "LaserSweepOcrValueB",
                        "sample_outlier_abs": 3.0,
                        "sample_outlier_pct": 1
                    }
                },
                "LaserSweepStart": {
                    "custom_action_param": {
                        "start": "{起始值}",
                        "end": "{结束值}",
                        "step": "{步长}",
                        "count": "{扫描点数}",
                        "wait_sec": "{等待秒数}",
                        "csv_dir": "{结果文件夹名}",
                        "csv_name": "{结果文件名}",
                        "output_root": "{输出总目录}",
                        "open_when_done": "{跑完自动打开}",
                        "csv_header": [
                            "序号",
                            "设定参数",
                            "B软件测量值",
                            "时间",
                            "备注"
                        ],
                        // ⚠️ 邮件字段放在**这里**，而不是「邮件设置」的 override 里。
                        //
                        // 为什么（2026-10-27 事故，血泪）：
                        //   pipeline_override 对同一个节点的 custom_action_param 是
                        //   **整体替换**，不是逐字段合并。扫描任务同时挂了「扫描设置」
                        //   和「邮件设置」两个 option，两份 override 都会写到
                        //   LaserSweepStart；后应用的那份会把前一份的字段**整个顶掉**。
                        //   我先前在「邮件设置」里又写了一份 LaserSweepStart（只含 smtp_*），
                        //   结果起始值/结束值/步长全被抹掉，agent 退回代码默认值
                        //   20→30，用户怎么调界面都是 20 起 —— 这就是那次严重 bug 的根因。
                        //
                        //   所以：**一个节点只能有一处 override**。LaserSweepStart 归
                        //   「扫描设置」管，邮件字段也一并写在这里（占位符引用的是
                        //   「邮件设置」里的输入项，跨 option 引用是允许的）。
                        "notify_mode": "{通知方式}",
                        "smtp_host": "{SMTP服务器}",
                        "smtp_port": "{SMTP端口}",
                        "smtp_ssl": true,
                        "smtp_user": "{SMTP账号}",
                        "smtp_password": "{SMTP密码}",
                        "mail_to": "{收件邮箱}",
                        "mail_subject_prefix": "{邮件主题前缀}",
                        "notify_limit": "{每次最多通知}",
                        "timeout_sec": 20
                    }
                },
                // ==============================================================
                //  读数守卫：判定相关参数进 agent
                //
                //  ⚠️ 这里把 LaserSweepGuard 的 custom_action_param **全部 11 个字段**
                //     写全了（整体替换语义，少一个就把它从原 pipeline 里抹掉）。
                //     字段集合必须和 my_task.json 里的 Guard 节点完全一致，
                //     改一边就要同步改另一边。
                //
                //  「异常时发不发邮件」只由 notify_enabled 一个布尔决定；
                //  真正发信用的账号/授权码/收件人由 agent 自己去读「邮件设置」
                //  那份配置（见 _resolve_mail_param），所以这里一个邮件字段都不用写。
                // ==============================================================
                "LaserSweepGuard": {
                    "custom_action_param": {
                        // 总开关（bool，界面传 "true"/"false"，agent 用 _flag() 解析）
                        "enabled": "{读数校验}",
                        // 判定阈值：两项取更宽松者，都超了才算异常
                        "tolerance_abs": "{绝对偏差阈值}",
                        "tolerance_pct": "{相对偏差阈值}",
                        // 重测策略：等多久、最多连续几次
                        "retry_wait": "{重测等待秒数}",
                        "retry_max": "{连续异常次数}",
                        // 三个出口节点名 + 重测前的稳定节点。
                        // 写成常量而不是占位符：换流程是开发期的事，
                        // 不该让用户在界面上误改（改错了表现为流程卡死，很难查）。
                        "retry_node": "LaserSweepRetryValue",
                        "record_node": "LaserSweepRecord",
                        "stop_node": "LaserSweepAbnormalStop",
                        "wait_node": "LaserSweepWaitSettle",
                        // ★ 主任务里唯一与邮件有关的设置（2026-10-27 重构）
                        "notify_enabled": "{读数异常发送邮件}",
                        // ★ 连续异常到顶之后：继续扫（true）还是停下（false）
                        "continue_on_abnormal": "{异常后继续测试}"
                    }
                },
                // 连续异常到顶后走这里：写空值占位 + 打印终止摘要 + 停任务。
                // 只需要 retry_max（用于日志/邮件里的「连续几次」说明），
                // 真正的计数在 agent 的 laser_sweep_guard 里维护。
                // 告警是否真的发出，取决于 Guard 的 notify_enabled。
                "LaserSweepAbnormalStop": {
                    "custom_action_param": {
                        "retry_max": "{连续异常次数}"
                    }
                },
                "LaserSweepDone": {
                    "custom_action_param": {
                        "open_when_done": "{跑完自动打开}"
                    }
                },
                "LaserSweepOpenOutput": {
                    "custom_action_param": {
                        "csv_dir": "{结果文件夹名}",
                        "output_root": "{输出总目录}"
                    }
                }
            }
        },
        // ======================================================================
        //  「邮件设置」—— 独立任务的配置（2026-10-27 新增）
        //
        //  谁在用这份配置：
        //    · 「邮件通知」任务  —— 扫描结束后发汇总信
        //    · 「邮件测试」任务  —— 立刻发一封测试信，验证配置
        //    · 「激光参数扫描」任务 —— 读数异常告警时（受 notify_enabled 控制）
        //  三处读的是同一份，改这里就全改了。
        //
        //  ⚠️ 授权码不写在这里（password 字段不能有 default，也不该出现在
        //     会入库的 JSON 里）。它只在 config/laser_sweep_mail.json 里，
        //     界面上留空即可，agent 会自动去读那份本地文件。
        // ======================================================================
        "邮件设置": {
            "type": "input",
            "label": "邮件设置",
            "description": "告警与完成通知共用的发信配置。填一次即可，被多个任务共享。",
            "inputs": [
                {
                    "name": "发送完成通知",
                    "label": "扫描结束后发送完成通知",
                    "description": "勾上：跑完「邮件通知」任务时，给这次扫描的结果发一封汇总信（扫了几组、成功几组、哪些行是空值、耗时、文件路径）。\n\n取消勾选：那个任务只是空跑一遍，不发信。\n\n⚠️ 这个开关只管「完成通知」，不影响读数异常时的告警邮件（那个去扫描任务的「读数异常发送邮件」里开关）。",
                    "default": "true",
                    "pipeline_type": "bool"
                },
                {
                    "name": "收件邮箱",
                    "label": "收件邮箱",
                    "description": "通知发到哪里。多个地址用**英文逗号**分隔。可以和发件邮箱填同一个（自己发给自己）。\n\n留空 = 不发信（会退化成只写日志）。",
                    "default": "",
                    // 空字符串是合法值（表示不发），所以正则里要留一个 ^$ 分支，
                    // 否则用户不填就会被红字拦下，任务根本起不来
                    "verify": "^$|^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
                    "pattern_msg": "留空，或填完整邮箱地址，如 you@example.com"
                },
                {
                    "name": "SMTP账号",
                    "label": "发件邮箱（SMTP 账号）",
                    "description": "用哪个邮箱发信。填**完整邮箱地址**，如 `yourname@qq.com`（QQ 邮箱的 SMTP 用户名就是完整地址）。",
                    "default": "",
                    "verify": "^$|^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
                    "pattern_msg": "留空，或填完整邮箱地址，如 yourname@qq.com"
                },
                {
                    "name": "SMTP密码",
                    "label": "SMTP 密码/授权码",
                    // password: true → 界面上掩码显示、不写日志。
                    // ⚠️ 协议 v2.10.0 规定：password 为 true 时**禁止**再给 default，
                    //    两者同时出现 schema 校验直接 fail（schema 里有 if/then 断言），
                    //    所以这一项故意没有 default。
                    "password": true,
                    "description": "这里填的是**授权码**，不是邮箱登录密码。\n\n**为什么不是登录密码**：QQ/163 等邮箱在开启了两步验证后，登录密码根本无法用于第三方客户端发信；服务商专门发放一串「授权码/SMTP 密码」给程序用，而且它能随时单独作废，不影响你平时登录。\n\n**QQ 邮箱怎么拿**（默认 smtp.qq.com:465）：网页版邮箱 →「设置」→「账号与安全」→「安全设置」→ 开启「SMTP 服务」（需短信验证）→「生成授权码」，得到一串 16 位字符，填到这里即可。\n\n**163 邮箱**：网页版 →「设置」→「POP3/SMTP/IMAP」→ 开启 SMTP 服务 → 设置客户端授权密码。\n\n**腾讯企业邮/企业微信邮箱**：管理后台为账号开启「客户端专用密码」，服务器用 `smtp.exmail.qq.com`（同样是 465 + SSL）。\n\n⚠️ 授权码只显示一次，拿到就先粘到记事本备份。也**不要**把它贴着发到群里。\n\n💡 **留空也能发**：授权码保存在本机的 `config/laser_sweep_mail.json` 里（该文件不入库、不进 Git），程序会自动去读。所以界面上这一项留空即可；填了就以界面为准。"
                },
                {
                    "name": "SMTP服务器",
                    "label": "SMTP 服务器",
                    "description": "默认 `smtp.qq.com`（QQ 邮箱）。163 用 `smtp.163.com`，腾讯企业邮/企业微信邮箱用 `smtp.exmail.qq.com`，学校/单位邮箱请查该邮箱的「客户端设置」帮助页。",
                    "default": "smtp.qq.com"
                },
                {
                    "name": "SMTP端口",
                    "label": "SMTP 端口",
                    "description": "默认 465（SSL 直连，推荐）。本程序固定按 SSL 连接，所以 25/587 这类非 SSL 或 STARTTLS 端口通常连不上；公司网络封了 465 时，可以先用手机热点验证是不是网络的问题（发信失败只会记日志，不影响任务本身）。",
                    "default": "465",
                    "verify": "^\\d+$",
                    "pattern_msg": "请填数字端口，例如 465"
                },
                {
                    "name": "邮件主题前缀",
                    "label": "邮件主题前缀",
                    "description": "邮件标题的前缀，后面会自动拼上「任务完成：…」或「读数异常告警：…」。想用邮箱规则自动分拣到「激光扫描」文件夹时，就靠这个前缀识别。",
                    "default": "[激光扫描]"
                },
                {
                    "name": "通知方式",
                    "label": "通知方式",
                    "description": "三种取值（小写）：\n\n- `auto`：配了收件邮箱 + SMTP 账号就发，没配就只写日志，不会报错；\n- `email`（默认）：强制发信，配错了会在日志里写明原因（但不影响任务本身）；\n- `off`：只写日志，不发信。\n\n⚠️ 默认 `email`：本机已配好可用账号，用 `email` 能让「配错了」立刻暴露在日志里，而不是静默退化成只写日志、等你以为会收到信时才发现没收到。",
                    "default": "email",
                    "//": "故意不放行 mail：agent 只认 email/auto/off，放行会变成校验通过但静默不生效",
                    "verify": "^(auto|email|off)$",
                    "pattern_msg": "请填 auto、email 或 off（小写）"
                },
                {
                    "name": "每次最多通知",
                    "label": "一次任务最多发几封",
                    "description": "防止反复触发把邮箱刷爆。填 1（默认）= 只发第一封；填 0 = 一封都不发（只写日志）。",
                    "default": "1",
                    "verify": "^\\d+$",
                    "pattern_msg": "请填非负整数，例如 1"
                }
            ],
            "pipeline_override": {
                // ⚠️⚠️ 这里**绝对不能**再写 LaserSweepStart！
                //
                //   2026-10-27 的严重 bug 就是这么来的：扫描任务同时挂
                //   「扫描设置」和「邮件设置」，两份 override 都写 LaserSweepStart，
                //   而 override 对 custom_action_param 是**整体替换**——
                //   后应用的那份把起始值/结束值/步长全顶掉了，agent 退回代码默认
                //   20→30，用户怎么调界面都从 20 开始扫。
                //
                //   现在 LaserSweepStart 的邮件字段写在「扫描设置」那一份里
                //   （见上面的注释），这里只负责「邮件通知」和「邮件测试」两个节点。
                //   tools/check_sample.py 有一条断言专门盯"同一节点不许被两处覆盖"。
                //
                // 「邮件通知」任务：扫描结束后发汇总信
                "LaserSweepSendSummary": {
                    "custom_action_param": {
                        "enabled": "{发送完成通知}",
                        "notify_mode": "{通知方式}",
                        "smtp_host": "{SMTP服务器}",
                        "smtp_port": "{SMTP端口}",
                        "smtp_ssl": true,
                        "smtp_user": "{SMTP账号}",
                        "smtp_password": "{SMTP密码}",
                        "mail_to": "{收件邮箱}",
                        "mail_subject_prefix": "{邮件主题前缀}",
                        "notify_limit": "{每次最多通知}",
                        "timeout_sec": 20
                    }
                },
                // 「邮件测试」任务：立刻发一封测试信
                "LaserSweepMailTest": {
                    "custom_action_param": {
                        "notify_mode": "{通知方式}",
                        "smtp_host": "{SMTP服务器}",
                        "smtp_port": "{SMTP端口}",
                        "smtp_ssl": true,
                        "smtp_user": "{SMTP账号}",
                        "smtp_password": "{SMTP密码}",
                        "mail_to": "{收件邮箱}",
                        "mail_subject_prefix": "{邮件主题前缀}",
                        "timeout_sec": 20
                    }
                }
            }
        }
    }
}
