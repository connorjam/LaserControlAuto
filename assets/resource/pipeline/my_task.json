{
    // ==========================================================================
    //  激光控制自动化 —— 参数扫描主流程
    //
    //  做什么：
    //    1. 在 A 软件（Low_Noise_Drive_Debugger_V2.13.exe）里设置一个参数
    //       ① OCR 找到 "Temperature" 这个词
    //       ② 点它右边的输入框，填数值
    //       ③ 点离这个词最近的 "Setting"
    //    2. 等待 10 秒
    //    3. 到 B 软件里图像识别，读出一个测量值
    //    4. 把「设定参数 + 测量值」追加写入 CSV
    //    5. 等待本次操作完毕，换下一个参数，回到第 1 步
    //       参数区间 20 ~ 30，步长 1，共 11 组
    //
    //  自定义动作 / 识别实现在  agent/laser_sweep.py
    //
    //  ── 一轮要多久、时间都花在哪（2026-10-12 按运行日志逐节点实测）────────
    //    优化前 ≈ 34 秒/轮（本机 1331x720，步长 5，3 组）：
    //      · 全屏 OCR ×2（找 Temperature、找 Setting）  中位 4.57 秒/次 ← 最贵，共约 9 秒
    //      · 等设备稳定（「等待秒数」，见 LaserSweepWaitSettle）10 秒
    //      · 读 B 软件（GDI 截图 + 全屏 OCR）            中位 5.54 秒
    //      · 等画面冻结 + 余量（LaserSweepWaitProcessDone）约 4.3 秒
    //      · 清空输入框（32 次退格，每次约 127 毫秒）    约 4.1 秒
    //      · 点击 / 输入 / 框架调度                      约 1.1 秒
    //
    //    优化后 ≈ 18 秒/轮（第一轮约 23 秒，因为要 OCR 一次来建定位缓存）：
    //      · 全屏 OCR：只剩第一轮那一次，之后全程复用缓存 → 0
    //      · 清空输入框：12 次退格 → 约 1.5 秒
    //      · 等画面冻结 → 0.2 秒
    //      · 剩下的就是硬成本：等稳定 10 秒 + 读 B 软件 5.5 秒
    //
    //  ── 还想再快，就动这两处（按收益排）─────────────────────────────────
    //      ① 「等待秒数」：设备实际多久稳定就填多少 —— 这是唯一"该等"的时间。
    //      ② 定位缓存参数（use_cache / cache_ttl / relocate_every / hint_roi_pad）：
    //         默认已是"第一次 OCR、之后全程复用"；想保守一点就写 relocate_every: 20
    //         （每复用 20 次重认一遍，防止长跑慢慢跑偏）。
    //      注意：节点之间**没有**额外的人为间隔，框架默认的 rate_limit(1000ms) /
    //      pre_delay / post_delay(各 200ms) 都已在下面各节点显式压成 0。
    //  ───────────────────────────────────────────────────────────────────
    //
    //  ── 读数采样（2026-10-27，见下面 ⑨ 那个节点）────────────────────────
    //    每个参数点不再只读一次：先在整屏里定位一次数值框（约 5.5 秒，只做一次），
    //    然后在 **1 秒**的时间窗里反复读那一小块，采到几次算几次
    //    （次数由这台机器 OCR 的实际速度决定，快机器几十次、慢机器两三次），
    //    最后取**平均数**写进 CSV。
    //    为什么：B 软件读数本身在抖（同组内 0.05 上下，和组间差异同量级），
    //    单次采样等于随手抓了一个瞬间，曲线起伏一半来自读数噪声。
    //    · 平均之前先按中位数圈出「正常带」（±max(3.0, |中位数|×1%)）剔掉误读 ——
    //      否则一个 -797.20 就能把 23 次采样的平均数拉成 -110.9
    //    · 顺带更快了：整屏 OCR 一轮只付一次，之后每轮只认数值框（约 1.1 秒/轮）
    //    · 采样参数都在 LaserSweepReadValueB 的 custom_recognition_param 里
    //  ───────────────────────────────────────────────────────────────────
    //
    //  ── 读数守卫（2026-10-26 新增，见下面 ⑩ 那一段）──────────────────────
    //    读到的数要先过一道校验再写 CSV：和上一个有效值比，
    //    绝对差 > tolerance_abs(默认 3.0) **且** 相对差 > tolerance_pct(默认 1%) 才判异常
    //    （任一在容差内就算正常，取更宽松的那个，避免误杀真实跳变）
    //    → 等 retry_wait(默认 3 秒) 重读同一个点，最多 retry_max(默认 5) 次；
    //    5 次都不可信：把这一组写成空值占位 + 发一封告警邮件，
    //    然后按 continue_on_abnormal(默认 true) 决定**继续扫下一个点**还是终止扫描
    //    （默认继续 —— 没人盯着的时候，让它跑完比停在半路更实用）。
    //    · 正常读数：零额外开销（只多一次比较 + 一次跳转改写，实测 0.016 毫秒）
    //    · 单次重测：约 9 秒（等 3 秒 + 读数 5.5 秒），这一轮从 18 秒变约 27 秒
    //    · 5 次全废：约 45 秒后继续下一个点（或按设置停机），不再拿可疑值污染 CSV
    //    阈值 / 次数 / 等待 / 邮箱都能在界面里改，默认值见 LaserSweepGuard。
    //  ───────────────────────────────────────────────────────────────────
    //
    //  ── 换成别的软件时要改什么 ───────────────────────────────────────────
    //  A 软件（要操作的那个）：
    //      ① 窗口标题 → assets/interface.json 的 win32.window_regex
    //      ② 标签文字 → LaserSweepFindTemperature 的 anchor_text
    //      ③ 偏移比例 → LaserSweepClickValueBox 的 dx_ratio
    //    就这三样。**不需要再量任何 roi 坐标** —— 同名干扰项由「配对法」自动排除。
    //
    //  B 软件（要读数的那个）：
    //      ① 窗口标题 → LaserSweepReadValueB 的 window_regex
    //      ② 标签文字 → LaserSweepReadValueB 的 anchor_text
    //    就这两样。**不需要量 roi**，靠「离标签最近的数值」自动定位。
    //    DPI 也不用管：agent 会读 GetDpiForWindow 自己适配
    //    （DPI 不感知的程序要用虚拟化坐标系截图，否则只能截到左上角 1/4）。
    //  ───────────────────────────────────────────────────────────────────
    //
    //  ── 实测数据留档（本机 1331x720 截图空间，换软件后可作参照）───────────
    //      · A 软件窗口标题       → Low Noise Driver Debugger V2.13（已写入 interface.json）
    //      · "Temperature:" 位置  → (494, 293, 96, 16)，在 Module Config 面板
    //      · 数值输入框           → 约 x 606~680；锚点中心 542 + 0.0736×1331 ≈ 640 ✓
    //      · 三个 Setting 按钮    → (705,149) (704,216) (704,284)，Temperature 那行是最下面一个
    //      · 干扰项（配对法自动排除）：
    //          左侧状态栏还有 'Temperature'（距离²=450392，被淘汰），
    //          右上标题是 'Settings'（带 s），PID Control 面板里还有第四个 'Setting'。
    //      · B 软件 GaussianBeam  → 客户区 1440x829，"Wavelength" 的数值是 "1061 nm"
    // ==========================================================================

    // ---------- ① 初始化：生成参数序列 + 建 CSV 表头 ----------
    "LaserSweepStart": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "laser_sweep_begin",
        "custom_action_param": {
            // ⚠️ 这里的值是**默认值**。用户在通用 UI 的「扫描设置」里填的内容
            //    会通过 interface.json 的 pipeline_override 整体替换掉这一块，
            //    所以两边要改就一起改（字段名必须一致，少一个字段就会被抹掉）。
            //    扫描点数与步长二选一：count > 0 走点数、否则走步长。
            "start": 20, // 扫描起始值
            "end": 30, // 扫描结束值（含）
            "step": 1, // 步长
            // 扫描总点数（2026-10-14 新增）。0（默认）= 按上面的步长算；
            // > 0 = 以点数为准，步长由「区间 ÷ (点数-1)」反算，此时忽略 step。
            // 例：20→30 填 11 就是步长 1；填 6 就是每步 2；填 1 就只扫起始值。
            // 除不尽时按反算的步长严格跑（如 4 个点是 20/23.333333/26.666667/30），
            // 想要每步都整齐就把 区间 ÷ (点数-1) 凑成整数。
            "count": 0,
            "wait_sec": 10, // 每轮在 A 软件设好参数后等多久（秒）
            // ── 结果输出（2026-10-16 起）──────────────────────────────────
            // 目录结构：软件目录/output/<本次文件夹名>/<文件名>.csv
            //   csv_dir        本次结果的子文件夹名，默认「系统时间_output」。
            //                  认 strftime（%Y%m%d 等）与 {date}/{time}/{datetime} 别名；
            //                  留空 = 用默认时间名。填绝对路径 = 直接当总目录（兼容老配置）。
            //   csv_name       结果文件名。留空 = 自动用「时间_起始值_终止值_总点数」，
            //                  如 20261016_143435_20_30_11（不写 .csv 会自动补）
            //   output_root    总目录名，默认 output（相对 interface.json 所在目录）
            //   open_when_done 跑完是否自动打开 output 文件夹，默认 true
            // 想整个换地方，就把 output_root 填绝对路径，如 "D:\\扫描数据"。
            "csv_dir": "",
            "csv_name": "",
            "output_root": "output",
            "open_when_done": true,
            "csv_header": ["序号", "设定参数", "B软件测量值", "时间", "备注"]
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "next": ["LaserSweepApplyParam"]
    },

    // ---------- ② 取本轮参数值，写进下面输入框节点的 input_text ----------
    "LaserSweepApplyParam": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "laser_sweep_apply_param",
        "custom_action_param": {
            "input_node": "LaserSweepTypeParam"
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "next": ["LaserSweepFindTemperature"]
    },

    // ---------- ③ 定位 "Temperature" 这个词 ----------
    // 识别成功后，框架会把这个词的位置记为「本节点的识别位置」，
    // 后面的节点就能用 target: "LaserSweepFindTemperature" 引用它。
    //
    // 这里用的是**配对法**而不是「OCR + 限定 roi」：
    //   界面上有两个 Temperature（左侧状态栏一个、Module Config 面板一个），
    //   原来的写法要靠写死 roi 把侧栏排除掉，窗口尺寸一变 roi 就失效。
    //   现在改成「谁的最近邻是 Setting 按钮，就选谁」——
    //   实测正确那个的距离²=41622，侧栏那个是 450392，差 11 倍，判定非常稳。
    //   于是 roi 可以恢复成全屏 [0,0,0,0]，不用再量面板范围。
    "LaserSweepFindTemperature": {
        "recognition": "Custom",
        "custom_recognition": "laser_find_nearest_setting",
        "custom_recognition_param": {
            // A 软件里那个参数的标签文字
            "anchor_text": "Temperature",
            // 用它来给多个同名标签「投票」：谁离按钮最近，谁才是真要操作的那一行
            "target_text": "Setting",
            // ★ 返回「标签与按钮之间那个输入框」的位置：
            //    每次执行都会重新 OCR 一屏，用实测的标签框 + 按钮框夹出输入框
            //    （中间若夹着数字就直接用那块数字的框），
            //    所以窗口尺寸 / DPI 怎么变都不用改配置，换电脑也不会点偏。
            //    可选值：input（输入框）/ anchor（标签本身）/ target（按钮）
            "return_box": "input",

            // ★ 界面上有多个 "Temperature" 时，用参照词钦定要用哪一个：
            //    取「离这个词最近」的那个标签（推荐，换分辨率也不会跑偏）。
            //    OCR 有时会把空格吃掉，所以可以写数组多给几种写法。
            //    也可以改用 "anchor_index": 1 —— 按「从上到下、从左到右」数，0 是第一个。
            "near_text": ["Module Config", "ModuleConfig"],

            // ★ 定位缓存：这一屏 OCR 出来的「标签 / 输入框 / 按钮」会一起存下来，
            //    之后每轮（以及下面 LaserSweepClickSetting 那次）直接复用，
            //    不再全屏 OCR —— 实测这一项每轮省下约 9 秒（两次 4.5 秒的 OCR）。
            //      use_cache       true（默认）/ false  关掉就退回「每次都 OCR」
            //      cache_ttl       秒，默认 600         缓存最长用多久，0 = 不因时间失效
            //      relocate_every  次数，默认 0         每复用几次强制重认一次，0 = 不强制
            //      hint_roi_pad    像素，默认 240       重新定位时先用「上次位置外扩」
            //                                          这个小 ROI 试一把，0 = 直接全屏
            "use_cache": true,

            // 标签只认短文本：界面上那些 Tips / 日志行动辄几十个字，
            // 一旦含 "Temperature" 就会冒充成标签（2026-09-22 实测被它带偏过）。
            "anchor_max_chars": 16,

            "roi": [0, 0, 0, 0],
            "ocr_node": "LaserSweepOcrSetting"
        },
        "action": "DoNothing",
        "timeout": 15000,
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "next": ["LaserSweepClickValueBox"],
        // 找不到这个词就没必要继续了，直接报错停下
        "on_error": ["LaserSweepAbort"]
    },

    // ---------- ④ 点 "Temperature" 右侧的输入框 ----------
    "LaserSweepClickValueBox": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "laser_click_right_of",
        // 锚点框从这里传进自定义动作（会落在 argv.box）
        "target": "LaserSweepFindTemperature",
        "custom_action_param": {
            // 默认点「target 节点识别出来的框」的中心 —— 也就是
            // LaserSweepFindTemperature 现场夹出来的那个输入框。
            //
            // ⚠️ 这里不要再写 dx_ratio / dy_ratio 了：那是「标签中心 + 窗口宽度 × 比例」
            //    的老办法，界面控件的间距并不会跟着窗口等比缩放，换台电脑就会点偏
            //    （2026-09-22 换机实测：1331x720 的机器上量出来的 0.0736 到小窗口上直接失准）。
            //    真需要额外微调时，可以填 dx_px / dy_px（像素）或 dx_ratio / dy_ratio（比例）。
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 150,
        "next": ["LaserSweepCaretToEnd"]
    },

    // ---------- ⑤ 清空输入框 ----------
    // ⚠️ 这里刻意不使用 Ctrl+A，原因是踩过坑：
    //    Win32 走 PostMessage 系列输入方式时，单独发 KeyDown(Ctrl) 再发 ClickKey(A)，
    //    目标程序（Qt）拿不到 Ctrl 的按下状态 —— 结果全选没生效，反倒把字母 'a'
    //    当成普通字符打了进去，于是每轮数值都往后拼接：
    //        a200a2a281a30a27.a240a2200
    //    改用「End 到行尾 + 连续 Backspace」就不依赖任何修饰键，稳得多。
    "LaserSweepCaretToEnd": {
        "recognition": "DirectHit",
        "action": "ClickKey",
        "key": 35, // VK_END，把光标移到输入框末尾
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 60,
        "next": ["LaserSweepClearField"]
    },
    "LaserSweepClearField": {
        "recognition": "DirectHit",
        "action": "ClickKey",
        "key": 8, // VK_BACK，退格
        // 重复多少次退格。每次实测约 127 毫秒（框架往目标程序发消息的往返开销），
        // 所以这个数字直接决定这一步要花几秒 —— 原来写 32 是"足够清掉 32 个字符"，
        // 但输入框里最多也就 "20.5" 这么长，12 次足够，耗时从 4.1 秒降到约 1.5 秒。
        // ⚠️ 如果哪天在日志里看到数值被拼接（比如 "20.525"），
        //    说明有残留字符没清干净，把这个数字调回 32 即可。
        "repeat": 12,
        "repeat_delay": 20,
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 80,
        "next": ["LaserSweepTypeParam"]
    },

    // 【备选】如果你的框架版本够新、并且想改回 Ctrl+A：
    //  agent 启动时会尽力声明「后台受管键」（见 agent/laser_sweep.py 的 _configure_controller），
    //  声明成功后下面的三节点写法就能正常工作。需要时把 LaserSweepClickValueBox.next
    //  改成 ["LaserSweepSelectAllDown"] 并取消整段注释即可。
    // "LaserSweepSelectAllDown": {
    //     "recognition": "DirectHit",
    //     "action": "KeyDown",
    //     "key": 17,
    //     "auto_up": true,
    //     "next": ["LaserSweepSelectAllPressA"]
    // },
    // "LaserSweepSelectAllPressA": {
    //     "recognition": "DirectHit",
    //     "action": "ClickKey",
    //     "key": 65,
    //     "next": ["LaserSweepSelectAllUp"]
    // },
    // "LaserSweepSelectAllUp": {
    //     "recognition": "DirectHit",
    //     "action": "KeyUp",
    //     "key": 17,
    //     "next": ["LaserSweepTypeParam"]
    // },

    // ---------- ⑥ 输入本轮参数值 ----------
    "LaserSweepTypeParam": {
        "recognition": "DirectHit",
        "action": "InputText",
        // 这里的 "20" 只是占位，运行期会被 LaserSweepApplyParam 动态覆盖成本轮的值
        "input_text": "20",
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 100,
        "next": ["LaserSweepClickSetting"]
    },

    // 【可选】如果 A 软件必须按回车才把输入框内容提交上去，
    //          就取消下面这段注释，并把 LaserSweepTypeParam.next 改成 ["LaserSweepCommitParam"]。
    // "LaserSweepCommitParam": {
    //     "recognition": "DirectHit",
    //     "action": "ClickKey",
    //     "key": 13, // VK_RETURN
    //     "rate_limit": 0,
    //     "pre_delay": 0,
    //     "post_delay": 200,
    //     "next": ["LaserSweepClickSetting"]
    // },

    // ---------- ⑦ 点离 "Temperature" 最近的那个 "Setting" ----------
    // 识别到之后用 Click 点它自己（target 默认 true）
    "LaserSweepClickSetting": {
        "recognition": "Custom",
        "custom_recognition": "laser_find_nearest_setting",
        "custom_recognition_param": {
            // 基准词：以它为圆心找最近的按钮
            "anchor_text": "Temperature",
            // 要点的按钮文字
            "target_text": "Setting",
            // ★ 这里要按钮本身，所以 return_box 用默认的 target
            // 搜索范围用全屏：PID Control 面板里也有一个 Setting（x≈881），
            // 左侧状态栏还有同名 "Temperature"，但配对法会自动选中距离最近的那一对，
            // 所以**不需要再写死面板 roi**，窗口尺寸变了也不用改。
            "roi": [0, 0, 0, 0],
            // 复用的 OCR 子节点名
            "ocr_node": "LaserSweepOcrSetting",
            // ★ 同上：这里吃 LaserSweepFindTemperature 那一趟攒下的缓存，
            //    正常情况下不会再跑一次全屏 OCR（省约 4.5 秒/轮）。
            //    缓存失效（过期 / 窗口尺寸变了 / 被 use_cache=false 关掉）时，
            //    会自动退回「用小 ROI 先试、再全屏」的重新定位路径。
            "use_cache": true
        },
        "action": "Click",
        "timeout": 15000,
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 200,
        "next": ["LaserSweepWaitSettle"],
        "on_error": ["LaserSweepAbort"]
    },

    // OCR 子节点：不参与主流程，只被 laser_find_nearest_setting 通过 run_recognition 调用
    // ⚠️ 这几个延时字段必须显式写 0：不写就会吃框架默认值
    //    （pre_delay / post_delay 各 200 毫秒、rate_limit 1000 毫秒）
    "LaserSweepOcrSetting": {
        "recognition": "OCR",
        "roi": [0, 0, 0, 0],
        "action": "DoNothing",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },

    // ---------- ⑧ 等待 10 秒，让设备稳定下来 ----------
    "LaserSweepWaitSettle": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        // 想改等待时长就改这里（单位毫秒）
        "post_delay": 10000,
        "rate_limit": 0,
        "pre_delay": 0,
        "next": ["LaserSweepReadValueB"]
    },

    // ---------- ⑨ 读取 B 软件的测量值（自定义识别）----------
    "LaserSweepReadValueB": {
        "recognition": "Custom",
        "custom_recognition": "laser_read_value_b",
        "custom_recognition_param": {
            // "fixed" = 不真的识别，每轮返回固定占位值（没有 B 软件时用）
            // "ocr"   = 去 B 软件里真实识别
            "mode": "ocr",
            "fixed_value": 0.0,

            // ===== B 软件窗口标题（正则）=====
            // 填了它，agent 会用 ctypes 直接抓 B 窗口的画面，
            // 不受「主控制器只绑定 A 窗口」的限制。留空则退回用主控制器的截图（也就是 A 的画面）。
            //
            // 为什么不是用 Win32Controller：
            //   MaaAgentServer.dll 里的 MaaWin32ControllerCreate 是个空壳，会报
            //   "MaaAgentServer Not implement this API" 并返回空句柄，
            //   所以 agent 进程里建不了第二个控制器，只能自己走 GDI 截图。
            //
            // 用 | 一次匹配多台电脑上的 B 软件，换机时不用改配置
            // 能不能只截数值框那一小块？取决于 window_regex：
            //   配了   → 直接走 Win32 GDI 只渲染那一块（2026-10-27 优化：
            //            1440x829 整窗 → 约 146x40，每帧渲染量降到 0.5%）
            //   没配   → 只能截 A 软件的画面（整屏），采样退化成整屏 OCR
            "window_regex": "^(GaussianBeam|光器件耦合系统.*)$",
            // 命中多个窗口时取第几个
            "window_index": 0,

            // ===== 要找的标签词 =====
            // 可以写一个词，也可以写数组（任一命中即可）。
            // 写成数组的好处是**一套配置伺候两套 B 软件**：
            //     GaussianBeam    ："Wavelength" 正下方就是数值 "1061 nm"
            //     光器件耦合系统  ："功率CH1" 右边就是数值 "-79.720dBm"
            // 程序先找「锚点右侧同一行」的数值，找不到再找「锚点正下方」的，
            // 两条都不成立才退回按中心距离挑最近的（会打警告）。
            //
            // ⚠️ 别配成 "CH1" 这种又能当标签、本身又含数字的词：
            //    宽松正则在标签自己身上就能匹配出 "1"，会变成每轮都读到 1。
            //    （2026-09-22 换机后在 "功率CH1" 上正是这么翻车的，现已由
            //      「不许和锚点重叠」这条规则兜住，但标签写得越明确越稳。）
            "anchor_text": ["功率CH1", "Wavelength"],

            // ===== 识别区域 [x, y, w, h]，[0,0,0,0] = 全屏 =====
            // 坐标空间 = B 窗口**客户区**的原始像素（不含标题栏）。
            // 注意这和 A 软件不同：A 走框架截图，会被缩放到短边 720；
            // B 是我们自己截的原图，所以用客户区原始坐标
            // （GaussianBeam 实测 1440x829）。
            "roi": [0, 0, 0, 0],

            // 数值解析正则，默认抓第一个数字（含小数、正负号）
            "pattern": "[-+]?\\d+(?:\\.\\d+)?",

            // ★ 数值候选必须「短」且「以数字为主」：
            //    B 软件下方是日志区，OCR 会认出
            //      "code=-1073807265, VISA Write in MY TSL-510_Initialize.vi->..."
            //    这种长句子 —— 它也含数字，还紧贴着上一行（边缘间距只有 1px），
            //    不挡掉就会以 1px 的优势抢走真正的 -79.720dBm（2026-09-22 实测）。
            //    "-79.720dBm" = 10 字 / 数字占比 0.6，"1061 nm" = 7 字 / 0.57，都在范围内。
            "value_max_chars": 24,
            "min_digit_ratio": 0.3,

            // 锚点同样只认短文本，免得日志行里的 "Wavelength" 冒充标签
            "anchor_max_chars": 16,

            "ocr_node": "LaserSweepOcrValueB",
            // 要找「离某词最近的数值」就必须做检测+识别，不能只识别
            "only_rec": false,

            // ===== 1 秒窗口多点采样（2026-10-27）=====
            // 在一个时间窗里**反复读**同一个数值框，最后取平均写进 CSV。
            // 「一秒读几次」不写死：先整屏定位一次拿到数值框（约 5.5 秒），
            // 之后每秒只认那一小块（零点几秒一次），OCR 快就多读几次、
            // 慢就少读几次，读多少次算多少次。
            //
            // 为什么要这样：B 软件的读数本身在抖（同一组内就差 0.05 上下，
            // 和组间差异同量级），单次采样等于随手抓了其中一个，
            // 曲线上的起伏一半来自读数噪声。平均之后噪声被压掉，
            // 组与组之间的差异才真实反映设定参数的影响。
            //
            // 时间账：第一轮 5.5 秒（定位）+ 1 秒（采样）≈ 6.5 秒；
            //        之后每轮约 1.1~1.3 秒 —— 比旧版（每轮 5.5 秒）还快，
            //        因为不用每次整屏 OCR 了。重测同理：一次约 4 秒（旧版 9 秒）。
            "sample_enabled": true, // false = 退回旧行为：每轮只读一次
            "sample_window_sec": 1, // 采样时间窗（秒）；0 = 只读一次
            "sample_max_count": 60, // 防呆上限，正常跑根本碰不到
            // 单次读数超过这个秒数就不再追加采样：说明这台机器 OCR 比采样窗还慢
            "sample_slow_sec": 5,
            // 采样时的窄 ROI 外扩像素：太小会切掉半个字
            "sample_roi_pad": 8,
            // 采样用的 OCR 节点（只认数值框那一小块，走 only_rec 更快）
            "sample_ocr_node": "LaserSweepOcrValueB",
            // 平均之前先剔误读：以中位数为圆心，±max(绝对, |中位数|×百分比) 以内算正常，
            // 带外的不参与平均（默认和读数守卫同量级：3.0 / 1%）。
            // 没有这一步，一个 -797.20 就能把 11 次采样的平均数拉成 -144。
            "sample_outlier_abs": 3.0,
            "sample_outlier_pct": 1
        },
        "action": "DoNothing",
        // 超时 10 秒 → 30 秒（2026-10-26）。
        // 原因：这个节点现在会在**同一次任务里被反复进入** —— 读数被判异常后，
        //   LaserSweepRetryValue 会绕回来重新读同一个点，最多 5 轮。
        //   原来那 10 秒是"一轮只读一次"时定的余量；现在每次重读都可能赶上
        //   GDI 截图 + 全屏 OCR 的偶发慢路径（实测中位 5.5 秒，最慢见过 9 秒），
        //   10 秒很容易把"正常但这次稍慢的一次重读"误判成超时，
        //   于是走 on_error → LaserSweepRecordFailed，白白写进一个空值。
        //   30 秒 = 正常读数 5.5 秒的两倍多，留够重测期间的抖动余量；
        //   真卡死也不会太久，因为外层还有 retry_max 次重试兜底。
        //
        // ⚠️ 2026-10-27 加了 1 秒多点采样后，正常一轮是「定位 5.5 秒 + 采样 1 秒」
        //    ≈ 6.5 秒，仍在 30 秒以内；但首次定位偶尔会撞上最慢路径（9 秒），
        //    再加上采样窗，所以保留 30 秒不动，别把它调小。
        "timeout": 30000,
        "pre_delay": 0,
        "post_delay": 0,
        // 显式写 0：不写就会吃框架默认的 1000 毫秒识别间隔
        "rate_limit": 0,
        // 读完先过守卫（⑩），由它决定往下走 CSV 还是回头重测
        "next": ["LaserSweepGuard"],
        "on_error": ["LaserSweepRecordFailed"]
    },

    // OCR 子节点：不参与主流程，只被 laser_read_value_b 通过 run_recognition 调用
    // ⚠️ 同样要显式写 0，别吃框架默认的 pre/post_delay 各 200 毫秒、rate_limit 1000 毫秒
    "LaserSweepOcrValueB": {
        "recognition": "OCR",
        "roi": [0, 0, 0, 0],
        // only_rec = 只识别不检测（整块 ROI 当成一段文字），框准了才用；
        // 要找「离某词最近的数值」必须设为 false，让它逐块检测
        "only_rec": false,
        "action": "DoNothing",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },

    // ---------- ⑩ 读数守卫：这个数到底可不可信？（自定义动作）----------
    // 为什么需要它（2026-10-26）：
    //   实测长跑无人值守时有三种"安静的坏数据"，它们**不会**让识别失败，
    //   所以 on_error 兜不住，只会安安静静把错的数写进 CSV：
    //     ① OCR 偶尔读错 —— 把 "-79.720dBm" 认成 "-79.720dBm" 旁边的日志数字，
    //        或者小数点丢一位（-7.9720）；
    //     ② 设备抖动 —— B 软件那一列还在爬升/回落，正好卡在读数那一瞬间；
    //     ③ 通信偶发失败 —— TSL-510 掉一次包，界面上的值会短暂停在旧值或跳到 0。
    //   这三种都是**单点跳变**：和前后点的走势明显对不上。
    //   一次扫描几十上百个点、跑上一两个小时，没人盯着，等回头翻 CSV
    //   才发现有个点离谱，那时已经白跑了。
    //
    // 判定口径（只看"上一个有效值"，不看全局拟合，避免误杀真实拐点）：
    //   绝对差 ≤ tolerance_abs（默认 3.0）**或** 相对差 ≤ tolerance_pct（默认 1%）
    //   就算正常 —— 两个容差是"取更宽松者"：大数值靠百分比、
    //   小数值靠绝对值，任一在范围内就放行，宁可漏判也不误杀真实跳变。
    //   （默认之所以压到 1%：实测这套数据整段扫描只漂 0.4，10% 等于永不触发，
    //    见 LaserSweepGuard 里 tolerance_pct 那段注释。）
    //   两项都超了才算异常，去重测。
    //   上一个值不存在时（第一组）直接拿它当基准放行，没有参照就没有"跳变"。
    //
    // 一轮为什么会变成（时间账）：
    //   · 正常读数          ：多一次数值比较 + 一次 next 改写，实测 < 1 毫秒，零额外开销；
    //   · 判异常重测 1 次   ：等 retry_wait（默认 3 秒）+ 重读（中位 5.5 秒）≈ 9 秒，
    //                         这一轮从 18 秒变约 27 秒 —— 仍然能接受，因为异常本来就少；
    //   · 连续 retry_max 次（默认 5）：约 5 × 9 = 45 秒，然后停机 + 发邮件。
    //                         用 45 秒换"不把 5 个可疑值写进 CSV"，划算。
    //
    // 三个出口都由本节点在运行期用 context.override_next 现改（和 LaserSweepAdvance
    // 改 done_node 是同一套写法）：
    //   retry_node  → LaserSweepRetryValue   等 retry_wait 后重读
    //   record_node → LaserSweepRecord       可信，正常写 CSV
    //   stop_node   → LaserSweepAbnormalStop 连续 5 次不可信，终止
    //
    // ⚠️ 这里的 custom_action_param 的值全是**默认值**：
    //    用户在通用 UI「扫描设置」里填的内容会通过 interface.json 的 pipeline_override
    //    整体替换掉这一块，两边要改就一起改（字段名必须一致，少一个字段就会被抹掉）。
    //    留空的字段一律写 ""（空字符串）而不是 null —— pipeline_override 的
    //    {占位符} 替换要求类型一致，null 会被替换成字符串后类型对不上，
    //    框架解析 SMTP 端口/开关时还会直接炸。
    "LaserSweepGuard": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "laser_sweep_guard",
        "custom_action_param": {
            // 总开关。false = 退回旧行为（读完直接写 CSV），排查"是不是守卫误判"时用
            "enabled": true,

            // ===== 判定阈值 =====
            // 绝对差容差（和上一个有效值比，差值在这个范围内就算正常）
            //
            // 2026-10-27 主人要求从 1.0 放宽到 3.0：宁可漏掉一次偶发误读，
            // 也不要因为阈值定得太紧而误杀真实波动。
            // 量级参考：真实组间波动约 0.04，3.0 是它的 75 倍 —— 正常跑绝不会触发；
            // 而"认错一位数字"这类误读动辄偏 5 以上（-79.72 → -85.3），照样抓得住。
            "tolerance_abs": 3.0,
            // 相对差容差（百分比）。和 tolerance_abs 是"取更宽松者"的关系，
            // 两者都超了才判异常，见上面的口径说明。
            //
            // ⚠️ 默认 1 而不是 10（2026-10-26 用真实数据算完改的）：
            //    实测 20→30 跑 11 组，功率从 -79.72 只漂到 -80.11 —— 整段才 0.4。
            //    10% 套在 -79.72 上是 ±7.97，等于给了上百倍于真实波动的余量，
            //    相对项永远胜出、绝对阈值一次都不生效，保护层等于没开。
            "tolerance_pct": 1,

            // ===== 重测策略 =====
            // 判异常后等多少秒再重读 —— 给设备留出恢复/稳定的时间
            "retry_wait": 3,
            // 最多连续重测几次；用完还不可信，就看下面的 continue_on_abnormal
            "retry_max": 5,
            // 三个出口节点名（写成参数是为了换流程时不用改 agent 代码）
            "retry_node": "LaserSweepRetryValue",
            "record_node": "LaserSweepRecord",
            "stop_node": "LaserSweepAbnormalStop",
            // 重测前先回到"等设备稳定"节点，让设备再过一遍降温/爬升
            "wait_node": "LaserSweepWaitSettle",

            // ===== 异常时要不要发邮件 =====
            // 2026-10-27 重构：邮件参数（账号/授权码/收件人/服务器）全部搬到
            // 独立的「邮件设置」里了，本节点**只留一个布尔开关**。
            //
            // 为什么这样更好：
            //   ① 本节点的 custom_action_param 从 19 项降到 11 项。
            //      它会被 pipeline_override「整体替换」，字段越少越不容易漏写；
            //      漏一个就等于把用户的配置抹成默认值（本项目踩过的坑）。
            //   ② 「读数检测」与「邮件通道」彻底解耦 —— 邮件配错了，
            //      不会再让读数校验这条链路看起来也出了问题。
            //   ③ 发信真正需要的配置，由 agent 在**要发的时候**才去读
            //      （见 _resolve_mail_param），正常读数路径一次磁盘都不碰。
            "notify_enabled": true,

            // ===== 连续异常到顶之后：继续扫还是停下 =====
            // 2026-10-27 新增，默认 true（继续）。
            // 主人的原话：异常出现了邮件发给我，但我未必有时间处理，
            // 最合适的是让它继续测试 —— 别因为一个点把整轮扫描停在半路。
            //
            // true  ：发告警邮件 → 当前这组写空值占位 → 继续扫下一个点
            // false ：发告警邮件 → 走 stop_node 终止整个扫描（旧行为）
            //
            // 两种都会发信，区别只在要不要停下。界面上可以随时切。
            "continue_on_abnormal": true
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        // 只是**默认兜底**：正常情况下 agent 会用 context.override_next
        // 把出口改成 retry_node / record_node / stop_node 三者之一。
        // 这里写 LaserSweepRecord 是为了万一 agent 那边没改成功（比如节点名写错），
        // 流程仍然是"写 CSV 往下走"，而不是卡死或跳到未知节点。
        "next": ["LaserSweepRecord"]
    },

    // ---------- ⑪ 重测等待：停 retry_wait 秒后回上面重读同一个点 ----------
    // 为什么单独做一个节点而不是在 Guard 里 sleep：
    //   ① 延时是框架的事，让框架去等，不要把主线程卡在自定义动作里
    //      （动作里 sleep 会连同识别一起僵住，日志也刷不出来）；
    //   ② 延时值可以**不改 agent 代码**就调整 —— Guard 每次会用
    //      context.override_pipeline 把这里的 post_delay 改成界面上的
    //      「重测等待秒数」× 1000，所以下面的 3000 只是没配置时的默认值
    //      （和 Guard 的 retry_wait=3 对齐：两处默认值要一起改）。
    // 耗时：本节点自身约 3 秒，加上回去重读的 5.5 秒，一次重测约 9 秒。
    // 注意这里**刻意成环**：RetryValue → ReadValueB → Guard → RetryValue，
    //   这是设计好的重测回路，不是断链，也不是死循环 ——
    //   每一圈 Guard 都会 +1 计数，到 retry_max 就转去 AbnormalStop 跳出。
    "LaserSweepRetryValue": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        // 默认 3000 毫秒（= retry_wait 的 3 秒）。
        // 界面上的「重测等待秒数」会由 laser_sweep_guard 用 override_pipeline 覆盖这里，
        // 所以想改默认值就同时改这一行和 Guard 的 retry_wait。
        "post_delay": 3000,
        "rate_limit": 0,
        "pre_delay": 0,
        // 回到读数节点，重新读**同一个**参数点（不推进参数序列）
        "next": ["LaserSweepReadValueB"]
    },

    // ---------- ⑫ 连续重测仍不可信：写空值占位 + 告警 + 终止 ----------
    // 为什么没有 next：
    //   走到这里说明设备/软件已经不可信了，继续扫下去只会往 CSV 里灌垃圾数据，
    //   所以这里**故意不留出口** —— 节点执行完流程就结束（正常返回也算跑完，
    //   只是没有下一跳）。这是本项目里唯一"合法地没有 next 的终止节点"，
    //   和 LaserSweepAbort（出错中止）、LaserSweepDone（跑完收尾）是三种不同的收尾。
    //
    // 它做的三件事：
    //   ① 把当前这一组写成**空值占位**（和 LaserSweepRecordFailed 同一个写法：
    //      序号、设定参数、空测量值、时间都写进去）—— 保证 CSV 行数和扫描点数
    //      对得上，事后一眼就能看出"第 7 组空着 = 那组读数出问题了"，
    //      而不是行错了位、把后面的值全对应错；
    //   ② 按 Guard 传下来的配置发告警邮件（配了的话）；
    //   ③ 打印原因（哪个参数点、连续几次异常、各自读到什么）并结束流程。
    // 耗时：写一行 CSV + 发一封信，正常几十毫秒，网络慢时受 timeout_sec 上限保护。
    "LaserSweepAbnormalStop": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "laser_sweep_abnormal_stop",
        "custom_action_param": {
            // 连续几次不可信才停到这里 —— 只是给日志/邮件用的说明文字，
            // 真正的计数在 agent 的 laser_sweep_guard 里维护。
            // 界面上的「重测次数」会通过 pipeline_override 覆盖它。
            "retry_max": 5
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },

    // ---------- ⑬ 把结果追加进 CSV ----------
    "LaserSweepRecord": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "laser_sweep_record",
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "next": ["LaserSweepWaitProcessDone"]
    },
    "LaserSweepRecordFailed": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "laser_sweep_record_failed",
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        "next": ["LaserSweepWaitProcessDone"]
    },

    // ---------- ⑭ 等本次操作执行完毕 ----------
    "LaserSweepWaitProcessDone": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        // 这里原来是 post_wait_freezes: 3000 + post_delay: 1000（实测吃掉 4.3 秒/轮）。
        // 2026-10-12 复核后关掉：它等的是"A 软件画面别再抖"，可此刻测量值已经读完了，
        // 而下一轮开头本来就要「设参数 → 等 10 秒」——这 4 秒纯属空转。
        // 更麻烦的是：A 软件的实时数值一直在跳时，"冻结判定"可能一直不满足，
        // 一路拖到框架默认的 20 秒超时（09-21 那次日志里就见过 7.1 秒才过）。
        // ⚠️ 如果哪天发现 B 软件的测量值还没刷出来就被读了，再把它调回去
        //    （或干脆改成识别 B 软件的「完成」提示 / 等某个数值不再变化）。
        "post_wait_freezes": 0,
        "post_delay": 200,
        "rate_limit": 0,
        "pre_delay": 0,
        "next": ["LaserSweepAdvance"]
    },

    // ---------- ⑮ 换下一个参数；跑完 11 组就收尾 ----------
    "LaserSweepAdvance": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "laser_sweep_advance",
        "custom_action_param": {
            "done_node": "LaserSweepDone"
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0,
        // 默认回到流程头部继续下一组；参数用尽时由 laser_sweep_advance
        // 通过 context.override_next 改写成 LaserSweepDone
        "next": ["LaserSweepApplyParam"]
    },

    // ---------- ⑯ 收尾 ----------
    "LaserSweepDone": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "laser_sweep_finish",
        // open_when_done：跑完自动打开 output 总目录。
        // （界面上的开关会覆盖这里；缺字段时默认 true）
        "custom_action_param": {
            "open_when_done": true
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },

    // ---------- ⑰ 「打开输出文件夹」—— 界面上那个独立任务的入口 ----------
    // 与激光扫描流程完全无关：勾这个任务、点开始，就只是弹出 output 文件夹。
    // 不依赖扫描状态（没跑过也能用，目录不存在就现建一个空的），
    // 也不需要 A/B 软件开着 —— 但仍然要控制器连接成功，这是通用 UI 的前置条件。
    "LaserSweepOpenOutput": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "laser_sweep_open_output",
        "custom_action_param": {
            // 与 LaserSweepStart 保持同名同义（点数是给 laser_sweep_begin 用的，
            // 这里只用到输出相关的几个字段）
            "csv_dir": "",
            "output_root": "output"
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },

    // ---------- ⑰b 「绘制曲线图」—— 独立任务（2026-10-28 新增）----------
    // 做什么：把扫描导出的 CSV 画成曲线图（X = 温度 / CSV 的「设定参数」列，
    //         Y = B 软件读数 / CSV 的「B软件测量值」列），PNG 存到 CSV 同目录。
    //
    // 为什么独立于主任务：
    //   ① 绘图是事后动作，不参与「设参数 → 等稳定 → 读数 → 写 CSV」的循环；
    //   ② 只要 CSV 还在，随时可以重画（不用重跑一两小时的扫描）；
    //   ③ 绘图失败也绝不能影响扫描 —— 这里是单独的入口节点。
    //
    // 默认画哪一份：「最近导出的单个 CSV」。优先级见 agent 的 _resolve_plot_csv：
    //   本次会话扫描过 → laser_sweep_output.json 里的 last_csv → output 里最新的 CSV。
    // 用户也可以在「绘图设置」里填具体 CSV（或目录，自动取目录里最新的）。
    //
    // ⚠️ custom_action_param 的字段必须与 interface.json「绘图设置」里的
    //    pipeline_override 完全一致 —— override 是整体替换，少一个就丢一个。
    "LaserSweepPlotCurve": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "laser_sweep_plot_curve",
        "custom_action_param": {
            // 留空 = 自动选择最近导出的单个 CSV
            "source_csv": "",
            // 留空 = <CSV 文件名>_曲线.png（永远和 CSV 同目录）
            "image_name": "",
            // 画完是否用系统默认看图软件打开
            "open_when_done": true
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },

    // ---------- 出错时中止：打印原因 + 已有的 CSV 路径 ----------
    "LaserSweepAbort": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "laser_sweep_abort",
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },

    // ==========================================================================
    //  「邮件通知」—— 独立任务（2026-10-27 新增，主人要求）
    //
    //  做什么：给「最近一次扫描」的结果发一封汇总信 —— 扫了几组、成功几组、
    //  哪些行是空值、耗时多久、结果文件在哪。
    //
    //  为什么独立成一个任务，而不是塞进扫描流程的收尾：
    //    ① 扫描任务的节点参数越少越好（pipeline_override 是整体替换，字段多就易漏）；
    //    ② 「扫完报平安」和「读数异常告警」是两件事，混在一起很难查；
    //    ③ 想手动补发上一次的结果，直接再点一次这个任务即可 ——
    //       它读的是 _state 里残留的记录和磁盘上的 CSV，不要求刚刚跑完扫描。
    //
    //  成本：一封邮件约 1~2 秒（含 SSL 握手与投递），且只在用户主动执行时才发生，
    //  不会拖慢任何一轮扫描 —— 这正是主人要求「读数正常时迅速进入下一步」的一部分。
    // ==========================================================================
    "LaserSweepSendSummary": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "laser_sweep_send_summary",
        "custom_action_param": {
            // 邮件参数都是**默认值**：界面「邮件设置」里的内容会经
            // interface.json 的 pipeline_override 整体替换掉这一块。
            // ⚠️ 两边字段名必须逐字一致，少一个就会被抹掉。
            //
            // 发不发这封信，由界面上的「发送完成通知」控制（enabled）。
            "enabled": true,
            // auto = 配齐就发、没配就只写日志；email = 必须发；off = 不发
            "notify_mode": "auto",
            "smtp_host": "",
            "smtp_port": 465,
            "smtp_ssl": true,
            "smtp_user": "",
            "smtp_password": "",
            "mail_to": "",
            "mail_subject_prefix": "[激光扫描]",
            "notify_limit": 1,
            // 发信超时（秒）：宁可放弃这封通知，也不要把收尾卡住
            "timeout_sec": 20
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },

    // ---------- 「邮件测试」：立刻发一封测试信验证配置 ----------
    // 为什么值得有：邮件配错平时完全看不出来，只有等到「连续 5 次读数异常」
    // 那一刻才暴露 —— 而那正是最不该发现「原来邮件一直发不出去」的时候。
    "LaserSweepMailTest": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "laser_sweep_mail_test",
        "custom_action_param": {
            "notify_mode": "auto",
            "smtp_host": "",
            "smtp_port": 465,
            "smtp_ssl": true,
            "smtp_user": "",
            "smtp_password": "",
            "mail_to": "",
            "mail_subject_prefix": "[激光扫描]",
            "timeout_sec": 20
        },
        "rate_limit": 0,
        "pre_delay": 0,
        "post_delay": 0
    },

    // ==========================================================================
    //  以下为 MaaFramework 模板自带的示例节点，与激光扫描无关，可整段删除
    //  （删除时记得同步删掉 assets/interface.json 里对应的 task 条目）
    // ==========================================================================
    "MyTask1": {},
    "MyTask2": {},
    "MyTask3": {},
    "FindSmallestNumber": {
        "recognition": "Custom",
        "custom_recognition": "find_smallest_number",
        "custom_recognition_param": {
            "candidate_rois": [
                [100, 100, 200, 100],
                [300, 100, 200, 100]
            ]
        },
        "action": "Custom",
        "custom_action": "click_target",
        "custom_action_param": {
            "target": [10, 20]
        }
    },
    "RecognizeNumber": {
        "recognition": "OCR"
    },
    "OcrTask": {
        "recognition": "OCR"
    }
}
